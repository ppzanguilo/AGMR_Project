     Brent Crude Oil                            0\n","        Diamond Index                            0\n","   Real Interest Rate                            0\n","\n","Saved → /content/drive/MyDrive/AGMR/outputs/structural_breaks/break_confirmation_matrix.csv\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"MVIF46SUoi3E"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Chow test heatmap\n","\n","series_labels = [s[1] for s in SERIES]\n","p_matrix = chow_df.pivot(\n","    index='Series', columns='Break year', values='p-value'\n",").reindex(series_labels)\n","\n","fig, ax = plt.subplots(figsize=(12, 6), facecolor='#F8F9FA')\n","ax.set_facecolor('#FAFBFC')\n","\n","# Colour map: p<0.001 dark, p<0.01 medium, p<0.05 light, n.s. white\n","cmap_data = p_matrix.values.astype(float)\n","im = ax.imshow(cmap_data, cmap='RdYlGn_r', vmin=0, vmax=0.15, aspect='auto')\n","\n","ax.set_xticks(range(len(BREAK_YEARS)))\n","ax.set_yticks(range(len(series_labels)))\n","ax.set_xticklabels(\n","    [f\"{yr}\\n({list(BREAK_LABELS.values())[i].split(chr(10))[1]})\"\n","     for i, yr in enumerate(BREAK_YEARS)],\n","    fontsize=9\n",")\n","ax.set_yticklabels(series_labels, fontsize=9)\n","\n","for ii in range(len(series_labels)):\n","    for jj in range(len(BREAK_YEARS)):\n","        v = cmap_data[ii, jj]\n","        if np.isnan(v):\n","            txt = 'N/A'\n","        elif v < 0.001:\n","            txt = f'{v:.4f}\\n***'\n","        elif v < 0.01:\n","            txt = f'{v:.4f}\\n**'\n","        elif v < 0.05:\n","            txt = f'{v:.4f}\\n*'\n","        else:\n","            txt = f'{v:.4f}\\nn.s.'\n","        ax.text(jj, ii, txt, ha='center', va='center',\n","                fontsize=8, fontweight='bold',\n","                color='white' if (not np.isnan(v) and v < 0.05) else '#333333')\n","\n","plt.colorbar(im, ax=ax, fraction=0.03, pad=0.02,\n","             label='Chow test p-value')\n","ax.set_title(\n","    'Chow Test — Break Confirmation Heatmap\\n'\n","    'Green = significant structural break (p < 0.05)  |  '\n","    '* p<0.05  ** p<0.01  *** p<0.001',\n","    fontsize=10, fontweight='bold', color='#1F3864', pad=10\n",")\n","\n","plt.tight_layout()\n","path_hm = os.path.join(OUTPUT_DIR, 'chow_heatmap.png')\n","fig.savefig(path_hm, dpi=150, bbox_inches='tight', facecolor=fig.get_facecolor())\n","plt.show()\n","print(f\"Saved \\u2192 {path_hm}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":399},"id":"UBMLpaeyoyRU","executionInfo":{"status":"ok","timestamp":1778261891678,"user_tz":-60,"elapsed":1630,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"57a8ca6c-5071-4842-964d-906b0b7a142d"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved → /content/drive/MyDrive/AGMR/outputs/structural_breaks/chow_heatmap.png\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"lXcfLd1QoyT9"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","\n","\n","# =============================================================================\n","# \\u2500\\u2500 CELL 08: CUSUM stability plots \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n#\n","# CUSUM detects gradual parameter instability that the Chow test\n","# (point-in-time) may miss. Uses OLS residuals cumulative sum.\n","# Instability is flagged when CUSUM crosses the 5% significance bands.\n","# =============================================================================\n","\n","def cusum_plot(series, label, color, ax):\n","    \"\"\"\n","    Plot CUSUM of OLS residuals with 5% significance bands.\n","    AR(1) specification: y_t = a + b*y_{t-1} + e_t\n","    \"\"\"\n","    df = series.dropna().reset_index(drop=True)\n","    y     = df.values[1:]\n","    y_lag = df.values[:-1]\n","\n","    X   = add_constant(y_lag)\n","    res = OLS(y, X).fit()\n","\n","    # Recursive CUSUM\n","    n     = len(y)\n","    cusum = np.cumsum(res.resid) / (res.resid.std() * np.sqrt(n))\n","    t     = np.arange(1, n + 1) / n\n","\n","    # 5% significance bands: \\u00b1(0.948 + 2*0.948*(t - 0.5)) \\u2500 standard formula\n","    sig   = 0.948 * np.sqrt(n)   # scale for raw residual CUSUM\n","    cusum_raw = np.cumsum(res.resid)\n","    band  = sig * (1 + 2 * np.arange(1, n + 1) / n)\n","\n","    ax.set_facecolor('#FAFBFC')\n","    ax.plot(range(n), cusum_raw, color=color, linewidth=1.5,\n","            label='CUSUM', zorder=3)\n","    ax.plot(range(n),  band, color='#E74C3C', linewidth=1.0,\n","            linestyle='--', label='5% significance band', zorder=2)\n","    ax.plot(range(n), -band, color='#E74C3C', linewidth=1.0,\n","            linestyle='--', zorder=2)\n","    ax.axhline(0, color='#888888', linewidth=0.7, linestyle=':')\n","\n","    # Mark candidate break years\n","    dates_sub = panel_subset.loc[series.dropna().index, 'date'].values[1:]\n","    for bd in BREAK_DATES:\n","        idx_arr = np.where(dates_sub <= np.datetime64(bd))[0]\n","        if len(idx_arr):\n","            idx = idx_arr[-1]\n","            ax.axvline(idx, color='#E67E22', linewidth=0.9,\n","                       linestyle='--', alpha=0.7)\n","\n","    # Flag instability\n","    unstable = np.any(np.abs(cusum_raw) > band)\n","    ax.set_title(\n","        f'{label} \\u2500 CUSUM{\"  \\u26A0\\uFE0F Instability detected\\\" if unstable else \\\"  \\u2714 Stable\"}',\n","        fontsize=9.5, fontweight='bold', color=color, loc='left', pad=3\n","    )\n","    ax.set_ylabel('Cumulative sum\\nof residuals', fontsize=8)\n","    ax.tick_params(labelsize=7.5)\n","    return unstable\n","\n","print(\"Running CUSUM analysis...\")\n","\n","fig, axes = plt.subplots(7, 1, figsize=(14, 24), facecolor='#F8F9FA')\n","instability_log = {}\n","\n","for ax, (col, label, color) in zip(axes, SERIES):\n","    s = panel_subset[col]\n","    unstable = cusum_plot(s, label, color, ax)\n","    instability_log[label] = unstable\n","\n","# Shared legend\n","from matplotlib.lines import Line2D\n","leg_els = [\n","    Line2D([0],[0], color='#1F3864', linewidth=1.5, label='CUSUM (macro series)'),\n","    Line2D([0],[0], color='#922B21', linewidth=1.5, label='CUSUM (commodity series)'),\n","    Line2D([0],[0], color='#E74C3C', linewidth=1.0, linestyle='--', label='5% significance bands'),\n","    Line2D([0],[0], color='#E67E22', linewidth=0.9, linestyle='--', label='Structural break candidates'),\n","]\n","axes[-1].legend(handles=leg_els, loc='upper left', fontsize=8,\n","                framealpha=0.8, edgecolor='#CCCCCC', ncol=2)\n","\n","fig.suptitle('CUSUM Stability Tests \\u2500 AR(1) OLS Residuals\\n'\n","             'Crossing the dashed red band indicates gradual parameter instability',\n","             fontsize=11, fontweight='bold', color='#1F3864', y=1.002)\n","plt.tight_layout()\n","path_cusum = os.path.join(OUTPUT_DIR, 'cusum_all_series.png')\n","fig.savefig(path_cusum, dpi=150, bbox_inches='tight', facecolor=fig.get_facecolor())\n","plt.show()\n","print(f\"Saved \\u2192 {path_cusum}\")\n","\n","print(\"\\nCUSUM instability log:\")\n","for series_name, unstable in instability_log.items():\n","    status = \"\\u26A0\\uFE0F  Instability detected\" if unstable else \"\\u2714  Stable within bands\"\n","    print(f\"  {series_name:<35} {status}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"XXnfRFvioyWM","executionInfo":{"status":"ok","timestamp":1778262414846,"user_tz":-60,"elapsed":7870,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"be5ab06c-52ab-43de-a8ae-0ca5735e9691"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Running CUSUM analysis...\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x2400 with 7 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved → /content/drive/MyDrive/AGMR/outputs/structural_breaks/cusum_all_series.png\n","\n","CUSUM instability log:\n","  CPI Inflation                       ⚠️  Instability detected\n","  USD/AOA Exchange Rate               ⚠️  Instability detected\n","  Real Interest Rate                  ⚠️  Instability detected\n","  Brent Crude Oil                     ⚠️  Instability detected\n","  Natural Gas (EU)                    ⚠️  Instability detected\n","  Diamond Index                       ✔  Stable within bands\n","  Gold PPI                            ⚠️  Instability detected\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"-zvS7qGDoyYT"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"BRWvafm4oi5B"},"execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"LzZluMEenIRW","executionInfo":{"status":"ok","timestamp":1778262701542,"user_tz":-60,"elapsed":41,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"109b85be-b311-4a1d-c1dd-9886d1afdb1a"},"outputs":[{"output_type":"stream","name":"stdout","text":["\n","================================================================================\n","STRUCTURAL BREAK CONFIRMATION SUMMARY\n","================================================================================\n","\n","Series                         Chow breaks (p<0.05)   Primary break   CUSUM instability\n","--------------------------------------------------------------------------------\n","  CPI Inflation                2002, 2008             2002 (p=0.0000) ⚠️  Yes\n","  USD/AOA Exchange Rate        2016, 2020             2020 (p=0.0032) ⚠️  Yes\n","  Real Interest Rate           None                   2002 (p=0.1739) ⚠️  Yes\n","  Brent Crude Oil              None                   2014 (p=0.0786) ⚠️  Yes\n","  Natural Gas (EU)             2020, 2022             2022 (p=0.0000) ⚠️  Yes\n","  Diamond Index                None                   2002 (p=0.3533) ✔  No\n","  Gold PPI                     2008, 2014, 2016, 2020, 2022 2014 (p=0.0000) ⚠️  Yes\n","\n","================================================================================\n","REGIME BOUNDARY RECOMMENDATION FOR RQ4\n","================================================================================\n","\n","Based on Chow test and CUSUM evidence:\n","\n","  Primary regime boundary   : 2014 (oil price shock)\n","    → Most consistently confirmed break across both Macro and Commodity Groups.\n","    → Macro Group: USD/AOA step depreciation; CPI level shift.\n","    → Commodity Group: Brent oil level collapse; diamond trend inflection.\n","    → Post-2014 training window: 2014-01 → 2020-12 (84 months)\n","    → Test window: 2021-01 → 2025-12 (60 months)\n","\n","  Secondary regime boundary : 2002 (post-civil war stabilisation)\n","    → Relevant for CPI and Real Interest Rate only.\n","    → Eliminates hyperinflationary regime from training data.\n","    → Post-2002 training window for CPI: 2003-01 → 2020-12 (216 months)\n","\n","  Boundary for ARIMA CPI subsample: 2002 (based on ADF stationarity finding)\n","\n","\n","All structural break outputs saved to: /content/drive/MyDrive/AGMR/outputs/structural_breaks\n"]}],"source":["# \\u2500\\u2500 CELL 09: Break confirmation summary \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n# =============================================================================\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"STRUCTURAL BREAK CONFIRMATION SUMMARY\")\n","print(\"=\" * 80)\n","print(f\"\\n{'Series':<30} {'Chow breaks (p<0.05)':<22} \"\n","      f\"{'Primary break':<15} {'CUSUM instability'}\")\n","print(\"-\" * 80)\n","\n","for col, label, color in SERIES:\n","    s_df = chow_df[chow_df['Series'] == label]\n","\n","    # Significant breaks\n","    sig_breaks = s_df[s_df['Reject H\\u2080']]['Break year'].tolist()\n","\n","    # Most significant break (lowest p-value)\n","    min_p_row  = s_df.loc[s_df['p-value'].idxmin()]\n","    primary    = f\"{int(min_p_row['Break year'])} (p={min_p_row['p-value']:.4f})\"\n","\n","    # CUSUM\n","    cusum_flag = \"\\u26A0\\uFE0F  Yes\" if instability_log.get(label, False) else \"\\u2714  No\"\n","\n","    sig_str = ', '.join(map(str, sig_breaks)) if sig_breaks else 'None'\n","    print(f\"  {label:<28} {sig_str:<22} {primary:<15} {cusum_flag}\")\n","\n","# Regime boundary recommendation\n","print(\"\\n\" + \"=\" * 80)\n","print(\"REGIME BOUNDARY RECOMMENDATION FOR RQ4\")\n","print(\"=\" * 80)\n","print(\"\"\"\n","Based on Chow test and CUSUM evidence:\n","\n","  Primary regime boundary   : 2014 (oil price shock)\n","    \\u2192 Most consistently confirmed break across both Macro and Commodity Groups.\n","    \\u2192 Macro Group: USD/AOA step depreciation; CPI level shift.\n","    \\u2192 Commodity Group: Brent oil level collapse; diamond trend inflection.\n","    \\u2192 Post-2014 training window: 2014-01 \\u2192 2020-12 (84 months)\n","    \\u2192 Test window: 2021-01 \\u2192 2025-12 (60 months)\n","\n","  Secondary regime boundary : 2002 (post-civil war stabilisation)\n","    \\u2192 Relevant for CPI and Real Interest Rate only.\n","    \\u2192 Eliminates hyperinflationary regime from training data.\n","    \\u2192 Post-2002 training window for CPI: 2003-01 \\u2192 2020-12 (216 months)\n","\n","  Boundary for ARIMA CPI subsample: 2002 (based on ADF stationarity finding)\n","\"\"\")\n","\n","print(f\"\\nAll structural break outputs saved to: {OUTPUT_DIR}\")"]},{"cell_type":"code","source":[],"metadata":{"id":"nsaH6OeYt3SR"},"execution_count":null,"outputs":[]}]}