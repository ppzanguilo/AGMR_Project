{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOvKSXDMaHoUNqHo9GGcbgU"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# =============================================================================\n","# GMR — Aksanti Global Market Research\n","# Pipeline Step 02 — Structural Break Analysis (Chow + CUSUM)\n","# QM640 Data Analytics Capstone | Príncipe Zanguilo | Walsh College\n","#\n","# Outputs:\n","#   - chow_results.csv              : Chow F-test p-values per series per date\n","#   - break_confirmation_matrix.csv : ranked confirmed breaks per series\n","#   - chow_heatmap.png              : visual confirmation matrix\n","#   - cusum_<series>.png            : CUSUM stability plots per series\n","# ============================================================================="],"metadata":{"id":"hOj7SWkcnbpJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Mounting Google Drive and setting file paths\n","import os\n","from google.colab import drive\n","drive.mount('/content/drive', force_remount=True)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"4DIGVAd7nbsN","executionInfo":{"status":"ok","timestamp":1778261542149,"user_tz":-60,"elapsed":23737,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"dbe3b49e-759c-458e-8722-77a2ed354d3f"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}]},{"cell_type":"code","source":["# Importing libraries\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.ticker as mticker\n","import matplotlib.dates as mdates\n","from matplotlib.lines import Line2D\n","import os\n","import warnings\n","warnings.filterwarnings('ignore')\n","import matplotlib.gridspec as gridspec\n","from matplotlib.patches import Patch\n","import scipy.stats as stats\n","from statsmodels.graphics.tsaplots import plot_acf, plot_pacf\n","from statsmodels.tsa.stattools import adfuller, kpss\n","\n","pd.set_option('display.float_format', '{:.4f}'.format)\n","pd.set_option('display.max_columns', 20)\n","pd.set_option('display.width', 130)\n","\n","\n","\n","FONT = 'DejaVu Sans'\n","plt.rcParams.update({\n","    'font.family'       : FONT,\n","    'axes.spines.top'   : False,\n","    'axes.spines.right' : False,\n","    'axes.grid'         : True,\n","    'grid.linestyle'    : ':',\n","    'grid.alpha'        : 0.35,\n","})\n","\n","\n","print(\"Libraries loaded ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uZNW4b3Vnbuz","executionInfo":{"status":"ok","timestamp":1778261551508,"user_tz":-60,"elapsed":1138,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"586da8d7-61d2-4e2b-bea5-0881c3335442"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Libraries loaded ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"zymc7UPcnbxJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","DATA_DIR = '/content/drive/MyDrive/AGMR/timeseries/raw'\n","\n","OUTPUT_DIR = '/content/drive/MyDrive/AGMR/outputs/structural_breaks'\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","\n","PANEL_FILE = os.path.join(DATA_DIR, 'agmr_panel_7series_monthly.csv')\n","SUBSET_START = '1995-01-01'\n","SUBSET_END   = '2025-12-01'"],"metadata":{"id":"muw4L8hZn0lt"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"y9PfjegTn0oS"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["panel = pd.read_csv(PANEL_FILE, parse_dates=['date'])\n","panel = panel.sort_values('date').reset_index(drop=True)\n","\n","panel_subset = panel[\n","    (panel['date'] >= SUBSET_START) &\n","    (panel['date'] <= SUBSET_END)\n","].copy().reset_index(drop=True)\n","\n","print(f\"panel_subset: {panel_subset.shape[0]} rows  |  \"\n","      f\"{panel_subset['date'].min().strftime('%Y-%m')} → \"\n","      f\"{panel_subset['date'].max().strftime('%Y-%m')}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5W5YOkeUoGIr","executionInfo":{"status":"ok","timestamp":1778261561190,"user_tz":-60,"elapsed":643,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"76bfdb23-35e8-406f-d37e-290917826d2d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["panel_subset: 372 rows  |  1995-01 → 2025-12\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"7PqAWXs9oGLL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# ── CELL 03: Configuration ────────────────────────────────────────────────────\n","\n","SERIES = [\n","    ('cpi_inflation_pct',          'CPI Inflation',          '#1F3864'),\n","    ('usd_aoa_monthly',            'USD/AOA Exchange Rate',  '#1F3864'),\n","    ('real_interest_rate_monthly', 'Real Interest Rate',     '#1F3864'),\n","    ('oil_brent_usd_bbl',          'Brent Crude Oil',        '#922B21'),\n","    ('nat_gas_usd_mmbtu',          'Natural Gas (EU)',        '#922B21'),\n","    ('diamond_usd_carat',          'Diamond Index',          '#922B21'),\n","    ('gold_usd',                   'Gold PPI',               '#922B21'),\n","]\n","\n","# Six candidate structural break dates (Angola-specific)\n","BREAK_YEARS = [2002, 2008, 2014, 2016, 2020, 2022]\n","BREAK_DATES = [pd.Timestamp(f'{y}-01-01') for y in BREAK_YEARS]\n","BREAK_LABELS = {\n","    2002: '2002\\n(Post-civil war)',\n","    2008: '2008\\n(GFC)',\n","    2014: '2014\\n(Oil shock)',\n","    2016: '2016\\n(Devaluation)',\n","    2020: '2020\\n(Pandemic)',\n","    2022: '2022\\n(Fiscal adj.)',\n","}\n","\n","print(\"Configuration set ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"iYOssKcqoGNV","executionInfo":{"status":"ok","timestamp":1778261574638,"user_tz":-60,"elapsed":15,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"c31038b4-a4e7-4708-83c7-5b84bec14114"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Configuration set ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"mFtZPuwGoGP3"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# =============================================================================\n","# Chow test function\n","#\n","# The Chow test tests H0: coefficients are equal across two subsamples.\n","# Specification: AR(1) model — y_t = a + b*y_{t-1} + e_t\n","# Split at each candidate break date; estimate restricted (full) and\n","# unrestricted (two-subsample) models; compute F-statistic.\n","#\n","# F = [(RSS_R - RSS_U) / k] / [RSS_U / (n1 + n2 - 2k)]\n","#   where k = number of parameters (2: intercept + AR1 coefficient)\n","# =============================================================================\n","\n","from statsmodels.api import OLS, add_constant\n","\n","def chow_test(series, break_date, min_obs=20):\n","    \"\"\"\n","    Chow test for structural break at break_date in an AR(1) specification.\n","    Returns F-statistic, p-value, and subsample sizes.\n","    \"\"\"\n","    df = series.dropna().reset_index(drop=True)\n","    dates = panel_subset.loc[series.dropna().index, 'date'].reset_index(drop=True)\n","\n","    # Build AR(1) dataset\n","    y     = df.values[1:]\n","    y_lag = df.values[:-1]\n","    d     = dates.values[1:]\n","\n","    if len(y) < 2 * min_obs:\n","        return None\n","\n","    # Split indicator\n","    mask = d < np.datetime64(break_date)\n","    n1, n2 = mask.sum(), (~mask).sum()\n","\n","    if n1 < min_obs or n2 < min_obs:\n","        return None\n","\n","    k = 2  # intercept + AR(1)\n","\n","    # Restricted model (full sample)\n","    X_r   = add_constant(y_lag)\n","    res_r = OLS(y, X_r).fit()\n","    rss_r = res_r.ssr\n","\n","    # Unrestricted: two separate regressions\n","    X1, y1 = add_constant(y_lag[mask]),  y[mask]\n","    X2, y2 = add_constant(y_lag[~mask]), y[~mask]\n","    res1   = OLS(y1, X1).fit()\n","    res2   = OLS(y2, X2).fit()\n","    rss_u  = res1.ssr + res2.ssr\n","\n","    # F-statistic\n","    f_stat = ((rss_r - rss_u) / k) / (rss_u / (n1 + n2 - 2 * k))\n","    p_val  = 1 - stats.f.cdf(f_stat, dfn=k, dfd=n1 + n2 - 2 * k)\n","\n","    return {\n","        'f_stat' : round(f_stat, 4),\n","        'p_value': round(p_val,  4),\n","        'n1'     : n1,\n","        'n2'     : n2,\n","        'reject' : p_val < 0.05,\n","    }"],"metadata":{"id":"2MI37ddPn0qW"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"qMyCD6zjoitB"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Run Chow tests for all series × all break dates\n","\n","\n","chow_rows = []\n","\n","for col, label, color in SERIES:\n","    s = panel_subset[col]\n","    for yr, bd in zip(BREAK_YEARS, BREAK_DATES):\n","        result = chow_test(s, bd)\n","        if result is None:\n","            chow_rows.append({\n","                'Series'    : label,\n","                'Break year': yr,\n","                'F-stat'    : np.nan,\n","                'p-value'   : np.nan,\n","                'n1'        : np.nan,\n","                'n2'        : np.nan,\n","                'Reject H\\u2080': False,\n","                'Significance': 'Insufficient data',\n","            })\n","        else:\n","            chow_rows.append({\n","                'Series'    : label,\n","                'Break year': yr,\n","                'F-stat'    : result['f_stat'],\n","                'p-value'   : result['p_value'],\n","                'n1'        : result['n1'],\n","                'n2'        : result['n2'],\n","                'Reject H\\u2080': result['reject'],\n","                'Significance': (\n","                    '*** p<0.001' if result['p_value'] < 0.001 else\n","                    '**  p<0.01'  if result['p_value'] < 0.01  else\n","                    '*   p<0.05'  if result['p_value'] < 0.05  else\n","                    '    n.s.'\n","                )\n","            })\n","\n","chow_df = pd.DataFrame(chow_rows)\n","\n","print(\"=\" * 80)\n","print(\"CHOW TEST RESULTS — AR(1) specification\")\n","print(\"H\\u2080: No structural break (equal coefficients across subsamples)\")\n","print(\"=\" * 80)\n","print(chow_df.to_string(index=False))\n","\n","path_chow = os.path.join(OUTPUT_DIR, 'chow_results.csv')\n","chow_df.to_csv(path_chow, index=False)\n","print(f\"\\nSaved \\u2192 {path_chow}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"AA-DXyuloivh","executionInfo":{"status":"ok","timestamp":1778261714263,"user_tz":-60,"elapsed":204,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"75ad685f-3e97-45c4-9b84-eb2670fab14e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["================================================================================\n","CHOW TEST RESULTS — AR(1) specification\n","H₀: No structural break (equal coefficients across subsamples)\n","================================================================================\n","               Series  Break year  F-stat  p-value  n1  n2  Reject H₀ Significance\n","        CPI Inflation        2002 10.7230   0.0000  83 288       True  *** p<0.001\n","        CPI Inflation        2008  4.0786   0.0177 155 216       True   *   p<0.05\n","        CPI Inflation        2014  1.4212   0.2427 227 144      False         n.s.\n","        CPI Inflation        2016  0.9437   0.3901 251 120      False         n.s.\n","        CPI Inflation        2020  0.5109   0.6004 299  72      False         n.s.\n","        CPI Inflation        2022  0.3563   0.7005 323  48      False         n.s.\n","USD/AOA Exchange Rate        2002  0.1307   0.8775  83 288      False         n.s.\n","USD/AO