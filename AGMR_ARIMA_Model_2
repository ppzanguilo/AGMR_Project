d":"XAl5ZLG4oHMh"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Best model registry\n","\n","TEST_START = '2021-01-01'\n","TEST_END   = '2025-12-01'\n","\n","BEST_MODELS = [\n","    # ── Macroeconomic Group ──────────────────────────────────────────────────\n","    {\n","        'col'         : 'cpi_inflation_pct',\n","        'label'       : 'CPI Inflation',\n","        'order'       : (3, 0, 1),\n","        'train_start' : '2014-01-01',\n","        'train_end'   : '2020-12-01',\n","        'drift'       : False,\n","        'mape_skip'   : False,\n","        'color'       : '#1F3864',\n","        'threshold'   : 5.0,\n","    },\n","    {\n","        'col'         : 'usd_aoa_monthly',\n","        'label'       : 'USD/AOA Exchange Rate',\n","        'order'       : (2, 1, 2),\n","        'train_start' : '2014-01-01',\n","        'train_end'   : '2020-12-01',\n","        'drift'       : True,\n","        'mape_skip'   : False,\n","        'color'       : '#1F3864',\n","        'threshold'   : 10.0,\n","    },\n","    {\n","        'col'         : 'real_interest_rate_monthly',\n","        'label'       : 'Real Interest Rate',\n","        'order'       : (4, 1, 3),\n","        'train_start' : '1995-01-01',\n","        'train_end'   : '2020-12-01',\n","        'drift'       : False,\n","        'mape_skip'   : True,    # near-zero denominator — use MAE/RMSE only\n","        'color'       : '#1F3864',\n","        'threshold'   : 8.0,\n","    },\n","    # ── Commodity Group ──────────────────────────────────────────────────────\n","    {\n","        'col'         : 'oil_brent_usd_bbl',\n","        'label'       : 'Brent Crude Oil',\n","        'order'       : (1, 1, 0),\n","        'train_start' : '1995-01-01',\n","        'train_end'   : '2020-12-01',\n","        'drift'       : False,\n","        'mape_skip'   : False,\n","        'color'       : '#922B21',\n","        'threshold'   : 12.0,\n","    },\n","    {\n","        'col'         : 'nat_gas_usd_mmbtu',\n","        'label'       : 'Natural Gas (EU)',\n","        'order'       : (3, 1, 2),\n","        'train_start' : '2014-01-01',\n","        'train_end'   : '2020-12-01',\n","        'drift'       : False,\n","        'mape_skip'   : False,\n","        'color'       : '#922B21',\n","        'threshold'   : 12.0,\n","    },\n","    {\n","        'col'         : 'diamond_usd_carat',\n","        'label'       : 'Diamond Index',\n","        'order'       : (2, 1, 2),\n","        'train_start' : '1995-01-01',\n","        'train_end'   : '2020-12-01',\n","        'drift'       : False,\n","        'mape_skip'   : False,\n","        'color'       : '#922B21',\n","        'threshold'   : 12.0,\n","    },\n","    {\n","        'col'         : 'gold_usd',\n","        'label'       : 'Gold PPI',\n","        'order'       : (2, 2, 1),\n","        'train_start' : '1995-01-01',\n","        'train_end'   : '2020-12-01',\n","        'drift'       : True,\n","        'mape_skip'   : False,\n","        'color'       : '#922B21',\n","        'threshold'   : 12.0,\n","    },\n","]\n","\n","print(\"Model registry loaded ✓\")\n","print(f\"\\n  {'Series':<28} {'Order':<14} {'Train window':<24} Drift\")\n","print(\"  \" + \"─\" * 70)\n","for m in BEST_MODELS:\n","    win = f\"{m['train_start'][:7]} → {m['train_end'][:7]}\"\n","    print(f\"  {m['label']:<28} ARIMA{str(m['order']):<10} {win:<24} \"\n","          f\"{'Yes' if m['drift'] else 'No'}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"irHiFcrgoHO4","executionInfo":{"status":"ok","timestamp":1778447535186,"user_tz":-60,"elapsed":8,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"d11bb722-8345-4e7f-ca4e-574bbea7bc37"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Model registry loaded ✓\n","\n","  Series                       Order          Train window             Drift\n","  ──────────────────────────────────────────────────────────────────────\n","  CPI Inflation                ARIMA(3, 0, 1)  2014-01 → 2020-12        No\n","  USD/AOA Exchange Rate        ARIMA(2, 1, 2)  2014-01 → 2020-12        Yes\n","  Real Interest Rate           ARIMA(4, 1, 3)  1995-01 → 2020-12        No\n","  Brent Crude Oil              ARIMA(1, 1, 0)  1995-01 → 2020-12        No\n","  Natural Gas (EU)             ARIMA(3, 1, 2)  2014-01 → 2020-12        No\n","  Diamond Index                ARIMA(2, 1, 2)  1995-01 → 2020-12        No\n","  Gold PPI                     ARIMA(2, 2, 1)  1995-01 → 2020-12        Yes\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"2i_JfT9roHRO"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Load panel\n","panel = pd.read_csv(PANEL_FILE, parse_dates=['date'])\n","panel = panel.sort_values('date').reset_index(drop=True)\n","\n","test  = panel[\n","    (panel['date'] >= TEST_START) &\n","    (panel['date'] <= TEST_END)\n","].copy().reset_index(drop=True)\n","\n","print(f\"Panel loaded  : {len(panel)} rows\")\n","print(f\"Test window   : {test['date'].min().strftime('%Y-%m')} → \"\n","      f\"{test['date'].max().strftime('%Y-%m')}  (n = {len(test)})\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"eM7jPSmhoHTk","executionInfo":{"status":"ok","timestamp":1778447537372,"user_tz":-60,"elapsed":51,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"9b756cf0-86ed-41e4-a0d4-594468325c88"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Panel loaded  : 2321 rows\n","Test window   : 2021-01 → 2025-12  (n = 60)\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"iWxjK4YGoyzO"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# Metric helpers\n","def mape(y, yhat):\n","    y, yhat = np.array(y), np.array(yhat)\n","    mask = y != 0\n","    return float(100 * np.mean(np.abs((y[mask] - yhat[mask]) / y[mask])))\n","\n","def rmse(y, yhat):\n","    return float(np.sqrt(np.mean((np.array(y) - np.array(yhat)) ** 2)))\n","\n","def mae_fn(y, yhat):\n","    return float(np.mean(np.abs(np.array(y) - np.array(yhat))))\n"],"metadata":{"id":"kt_FP9Ctoy2g"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"izUm-YGZoy5n"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ── Fit, forecast, evaluate ───────────────────────────────────────────────────\n","\n","results   = []\n","forecasts = []\n","fitted    = {}\n","\n","print(\"=\" * 65)\n","print(\"FITTING BEST ARIMA MODEL PER SERIES\")\n","print(\"=\" * 65)\n","\n","for s in BEST_MODELS:\n","\n","    # ── Data ─────────────────────────────────────────────────────────────────\n","    train = panel[\n","        (panel['date'] >= s['train_start']) &\n","        (panel['date'] <= s['train_end'])\n","    ][s['col']].dropna().reset_index(drop=True)\n","\n","    y_test     = test[s['col']].dropna().reset_index(drop=True)\n","    test_dates = test.loc[test[s['col']].notna(), 'date'].reset_index(drop=True)\n","\n","    print(f\"\\n{s['label']}\")\n","    print(f\"  ARIMA{s['order']}  drift={'Yes' if s['drift'] else 'No'}  \"\n","          f\"N_train={len(train)}  N_test={len(y_test)}\")\n","\n","    # ── Resolve trend parameter based on drift flag and d ────────────────────\n","    # statsmodels rules:\n","    #   d = 0  →  trend='c'  (constant in levels)\n","    #   d = 1  →  trend='t'  (linear trend = constant drift on Δ series)\n","    #   d = 2  →  trend='ct' (constant + linear trend = drift on Δ² series)\n","    d = s['order'][1]\n","    if not s['drift']:\n","        trend = 'n'\n","    elif d == 0:\n","        trend = 'c'\n","    elif d == 1:\n","        trend = 't'\n","    else:\n","        trend = 'n'\n","        print(f\"  Note: drift not applicable for d=2 — trend set to 'n'\")\n","\n","    # ── Fit ───────────────────────────────────────────────────────────────────\n","    model = ARIMA(train, order=s['order'], trend=trend).fit()\n","    fitted[s['col']] = model\n","\n","    # ── Forecast ─────────────────────────────────────────────────────────────\n","    fc   = model.get_forecast(steps=len(y_test))\n","    yhat = fc.predicted_mean.values\n","    ci   = fc.conf_int(alpha=0.05)\n","\n","    # ── Metrics ───────────────────────────────────────────────────────────────\n","    m_val  = mape(y_test.values, yhat)\n","    r_val  = rmse(y_test.values, yhat)\n","    ma_val = mae_fn(y_test.values, yhat)\n","\n","    # ── Ljung-Box ─────────────────────────────────────────────────────────────\n","    lb = acorr_ljungbox(model.resid, lags=[6, 12, 24], return_df=True)\n","    wn = all(lb['lb_pvalue'] > 0.05)\n","\n","    # ── Print ─────────────────────────────────────────────────────────────────\n","    if s['mape_skip']:\n","        print(f\"  AIC={model.aic:.2f}  RMSE={r_val:.4f}  MAE={ma_val:.4f}\"\n","              f\"  (MAPE excluded — near-zero denominator)\")\n","    else:\n","        flag = '\\u2714' if m_val <= s['threshold'] else '\\u2718'\n","        print(f\"  AIC={model.aic:.2f}  MAPE={m_val:.4f}%  \"\n","              f\"RMSE={r_val:.4f}  MAE={ma_val:.4f}  {flag}\")\n","\n","    print(f\"  LB p(6)={lb['lb_pvalue'].iloc[0]:.4f}  \"\n","          f\"p(12)={lb['lb_pvalue'].iloc[1]:.4f}  \"\n","          f\"p(24)={lb['lb_pvalue'].iloc[2]:.4f}  \"\n","          f\"{'✓ White noise' if wn else '✗ Residual autocorrelation'}\")\n","\n","    # ── Store ─────────────────────────────────────────────────────────────────\n","    results.append({\n","        'Series'    : s['label'],\n","        'Order'     : f\"ARIMA{s['order']}\",\n","        'Drift'     : 'Yes' if s['drift'] else 'No',\n","        'Trend'     : trend,\n","        'Window'    : f\"{s['train_start'][:7]} \\u2192 {s['train_end'][:7]}\",\n","        'N_train'   : len(train),\n","        'N_test'    : len(y_test),\n","        'AIC'       : round(model.aic, 4),\n","        'MAPE'      : round(m_val, 4) if not s['mape_skip'] else None,\n","        'RMSE'      : round(r_val, 4),\n","        'MAE'       : round(ma_val, 4),\n","        'LB_p6'     : round(lb['lb_pvalue'].iloc[0], 4),\n","        'LB_p12'    : round(lb['lb_pvalue'].iloc[1], 4),\n","        'LB_p24'    : round(lb['lb_pvalue'].iloc[2], 4),\n","        'WhiteNoise': wn,\n","    })\n","\n","    for k in range(len(y_test)):\n","        forecasts.append({\n","            'Series'    : s['label'],\n","            'Date'      : test_dates.iloc[k].strftime('%Y-%m'),\n","            'Actual'    : round(float(y_test.iloc[k]), 4),\n","            'Predicted' : round(float(yhat[k]), 4),\n","            'CI_Lower'  : round(float(ci.iloc[k, 0]), 4),\n","            'CI_Upper'  : round(float(ci.iloc[k, 1]), 4),\n","            'Error'     : round(float(y_test.iloc[k] - yhat[k]), 4),\n","            'Abs_Error' : round(float(abs(y_test.iloc[k] - yhat[k])), 4),\n","        })"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VXLFiDjMoy8P","executionInfo":{"status":"ok","timestamp":1778447544161,"user_tz":-60,"elapsed":1624,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"a7d361ae-4d1c-4dd0-d4aa-e08feb62fd7d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["=================================================================\n","FITTING BEST ARIMA MODEL PER SERIES\n","=================================================================\n","\n","CPI Inflation\n","  ARIMA(3, 0, 1)  drift=No  N_train=84  N_test=60\n","  AIC=108.63  MAPE=38.1791%  RMSE=0.6956  MAE=0.5791  ✘\n","  LB p(6)=0.6428  p(12)=0.7427  p(24)=0.8877  ✓ White noise\n","\n","USD/AOA Exchange Rate\n","  ARIMA(2, 1, 2)  drift=Yes  N_train=84  N_test=60\n","  AIC=646.76  MAPE=38.3161%  RMSE=257.3874  MAE=227.1965  ✘\n","  LB p(6)=0.7289  p(12)=0.9204  p(24)=0.9980  ✓ White noise\n","\n","Real Interest Rate\n","  ARIMA(4, 1, 3)  drift=No  N_train=312  N_test=60\n","  AIC=2251.24  RMSE=