s\n","DATA_DIR   = '/content/drive/MyDrive/AGMR/timeseries/raw'\n","ARIMA_DIR  = '/content/drive/MyDrive/AGMR/outputs/arima_best'\n","OUTPUT_DIR = '/content/drive/MyDrive/AGMR/outputs/ml'\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","PANEL_FILE = os.path.join(DATA_DIR,  'agmr_panel_7series_monthly.csv')\n","ARIMA_FILE = os.path.join(ARIMA_DIR, 'arima_best_forecasts.csv')"],"metadata":{"id":"AiI2U_Xl35xJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"DdfYwJn935zs"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Configuration\n","\n","TEST_START = '2021-01-01'\n","TEST_END   = '2025-12-01'\n","\n","WINDOWS = {\n","    'full_sample' : ('1995-01-01', '2020-12-01'),\n","    'post_2014'   : ('2014-01-01', '2020-12-01'),\n","}\n","\n","# ── Groups — no cross-group feature mixing ────────────────────────────────────\n","GROUPS = {\n","    'Macroeconomic': [\n","        ('cpi_inflation_pct',          'CPI Inflation',         '#1F3864'),\n","        ('usd_aoa_monthly',            'USD/AOA Exchange Rate', '#1F3864'),\n","        ('real_interest_rate_monthly', 'Real Interest Rate',    '#1F3864'),\n","    ],\n","    'Commodity': [\n","        ('oil_brent_usd_bbl',   'Brent Crude Oil',  '#922B21'),\n","        ('nat_gas_usd_mmbtu',   'Natural Gas (EU)', '#922B21'),\n","        ('diamond_usd_carat',   'Diamond Index',    '#922B21'),\n","        ('gold_usd',            'Gold PPI',         '#922B21'),\n","    ],\n","}\n","\n","# ── Structural break dummies ──────────────────────────────────────────────────\n","BREAK_DATES = [2002, 2008, 2014, 2016, 2020, 2022]\n","\n","# ── Deployment MAPE thresholds ────────────────────────────────────────────────\n","MAPE_THRESHOLD = {\n","    'cpi_inflation_pct'          : 5.0,\n","    'usd_aoa_monthly'            : 10.0,\n","    'real_interest_rate_monthly' : 8.0,\n","    'oil_brent_usd_bbl'          : 12.0,\n","    'nat_gas_usd_mmbtu'          : 12.0,\n","    'diamond_usd_carat'          : 12.0,\n","    'gold_usd'                   : 12.0,\n","}\n","MAPE_EXCLUDE = ['real_interest_rate_monthly']\n","\n","# ── XGBoost hyperparameter grid ───────────────────────────────────────────────\n","XGB_PARAMS = {\n","    'n_estimators'     : 300,\n","    'max_depth'        : 4,\n","    'learning_rate'    : 0.05,\n","    'subsample'        : 0.8,\n","    'colsample_bytree' : 0.8,\n","    'reg_alpha'        : 0.1,\n","    'reg_lambda'       : 1.0,\n","    'random_state'     : 42,\n","    'verbosity'        : 0,\n","}\n","\n","# ── Random Forest hyperparameters ─────────────────────────────────────────────\n","RF_PARAMS = {\n","    'n_estimators'  : 300,\n","    'max_depth'     : 6,\n","    'min_samples_leaf': 3,\n","    'random_state'  : 42,\n","    'n_jobs'        : -1,\n","}\n","\n","# ── Walk-forward CV folds ─────────────────────────────────────────────────────\n","N_SPLITS = 5\n","\n","plt.rcParams.update({\n","    'font.family'     : 'DejaVu Sans',\n","    'axes.spines.top' : False,\n","    'axes.spines.right': False,\n","    'axes.grid'       : True,\n","    'grid.linestyle'  : ':',\n","    'grid.alpha'      : 0.35,\n","})\n","print(\"Configuration set ✓\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uqpBWDLC352B","executionInfo":{"status":"ok","timestamp":1778453955217,"user_tz":-60,"elapsed":25,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"9f67098c-4539-486c-b6cd-bb094ff6f50d"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Configuration set ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"POtQgVsg354d"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Load panel\n","\n","panel = pd.read_csv(PANEL_FILE, parse_dates=['date'])\n","panel = panel.sort_values('date').reset_index(drop=True)\n","\n","# Load ARIMA forecasts for Diebold-Mariano comparison\n","arima_fc = pd.read_csv(ARIMA_FILE, parse_dates=['Date'])\n","\n","test = panel[\n","    (panel['date'] >= TEST_START) &\n","    (panel['date'] <= TEST_END)\n","].copy().reset_index(drop=True)\n","\n","print(f\"Panel  : {len(panel)} rows  \"\n","      f\"({panel['date'].min().strftime('%Y-%m')} → \"\n","      f\"{panel['date'].max().strftime('%Y-%m')})\")\n","print(f\"Test   : {len(test)} rows  \"\n","      f\"({test['date'].min().strftime('%Y-%m')} → \"\n","      f\"{test['date'].max().strftime('%Y-%m')})\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"stFamlKE3564","executionInfo":{"status":"ok","timestamp":1778453958172,"user_tz":-60,"elapsed":33,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"397d0b99-4615-4122-fe71-246f33af04fb"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Panel  : 2321 rows  (1833-01 → 2026-05)\n","Test   : 60 rows  (2021-01 → 2025-12)\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"zTEHmgrA359l"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Feature engineering\n","def build_features(df, target_col, group_cols, date_col='date'):\n","    \"\"\"\n","    Build feature matrix for one target series.\n","\n","    Features:\n","      Own lags        : lag-1, lag-3, lag-6, lag-12\n","      Rolling mean    : 3-month, 6-month  (computed at t-1)\n","      Rolling std     : 3-month, 6-month  (computed at t-1)\n","      Cross-series    : lag-1, lag-3 for all other series in the group\n","      Break dummies   : binary(date >= break_year) × 6\n","      Month dummies   : one-hot M2–M12 (M1 = reference)\n","\n","    Parameters\n","    ----------\n","    df         : full panel DataFrame (sorted by date)\n","    target_col : column to forecast\n","    group_cols : list of all column names in the group (including target)\n","    date_col   : name of the date column\n","    \"\"\"\n","    data = df[[date_col] + group_cols].copy()\n","\n","    feat = pd.DataFrame(index=data.index)\n","    feat[date_col] = data[date_col]\n","\n","    # ── Own lags ──────────────────────────────────────────────────────────────\n","    for lag in [1, 3, 6, 12]:\n","        feat[f'{target_col}_lag{lag}'] = data[target_col].shift(lag)\n","\n","    # ── Rolling mean (based on values up to t-1) ──────────────────────────────\n","    for window in [3, 6]:\n","        feat[f'{target_col}_rollmean{window}'] = (\n","            data[target_col].shift(1).rolling(window, min_periods=2).mean()\n","        )\n","\n","    # ── Rolling std (based on values up to t-1) ───────────────────────────────\n","    for window in [3, 6]:\n","        feat[f'{target_col}_rollstd{window}'] = (\n","            data[target_col].shift(1).rolling(window, min_periods=2).std()\n","        )\n","\n","    # ── Cross-series lags (other series in group) ─────────────────────────────\n","    for col in group_cols:\n","        if col == target_col:\n","            continue\n","        for lag in [1, 3]:\n","            feat[f'{col}_lag{lag}'] = data[col].shift(lag)\n","\n","    # ── Structural break dummies ──────────────────────────────────────────────\n","    for yr in BREAK_DATES:\n","        feat[f'break_{yr}'] = (\n","            data[date_col].dt.year >= yr\n","        ).astype(int)\n","\n","    # ── Month-of-year dummies (M2–M12; M1 = reference) ───────────────────────\n","    months = pd.get_dummies(data[date_col].dt.month, prefix='month')\n","    months = months.reindex(\n","        columns=[f'month_{m}' for m in range(1, 13)], fill_value=0\n","    )\n","    months = months.drop(columns=['month_1'], errors='ignore')\n","    feat   = pd.concat([feat, months.set_index(data.index)], axis=1)\n","\n","    # ── Target ────────────────────────────────────────────────────────────────\n","    feat['target'] = data[target_col].values\n","\n","    return feat.dropna().reset_index(drop=True)\n","\n","\n","def mape(y, yhat):\n","    y, yhat = np.array(y), np.array(yhat)\n","    mask = y != 0\n","    return float(100 * np.mean(np.abs((y[mask] - yhat[mask]) / y[mask])))\n","\n","def rmse(y, yhat):\n","    return float(np.sqrt(np.mean((np.array(y) - np.array(yhat)) ** 2)))\n","\n","def mae_fn(y, yhat):\n","    return float(np.mean(np.abs(np.array(y) - np.array(yhat))))\n","\n","print(\"Feature engineering functions defined ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5oxc602r7Lb8","executionInfo":{"status":"ok","timestamp":1778453961544,"user_tz":-60,"elapsed":34,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"6d4eb3ff-63b0-473e-a9bb-25a1bd23bda7"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Feature engineering functions defined ✓\n"]}]},{"cell_type":"code","source":["\n"],"metadata":{"id":"aSvpXc-l7Le_"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Walk-forward CV function\n","\n","def walkforward_cv(X, y, model_class, params, n_splits=N_SPLITS):\n","    \"\"\"\n","    Walk-forward expanding-window cross-validation.\n","    Returns mean MAPE across folds.\n","    \"\"\"\n","    tscv    = TimeSeriesSplit(n_splits=n_splits)\n","    scores  = []\n","\n","    for train_idx, val_idx in tscv.split(X):\n","        X_tr, X_val = X[train_idx], X[val_idx]\n","        y_tr, y_val = y[train_idx], y[val_idx]\n","\n","        # Standardise using training fold statistics\n","        scaler = StandardScaler()\n","        X_tr_s = scaler.fit_transform(X_tr)\n","        X_val_s = scaler.transform(X_val)\n","\n","        model = model_class(**params)\n","        model.fit(X_tr_s, y_tr)\n","        yhat = model.predict(X_val_s)\n","\n","        # MAPE on fold (skip if target contains zeros)\n","        m = mape(y_val, yhat) if np.all(y_val != 0) else rmse(y_val, yhat)\n","        scores.append(m)\n","\n","    return float(np.mean(scores))\n","\n","print(\"Walk-forward CV function defined ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Wx9OhQkr7Lhp","executionInfo":{"status":"ok","timestamp":1778453966244,"user_tz":-60,"elapsed":25,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"70c7d18b-a5c6-46ba-8f18-7ae65c67f585"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Walk-forward CV function defined ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"_DxOyzo_7LkQ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Main training and forecasting loop\n","\n","results   = []   # metrics rows\n","forecasts = []   # forecast rows\n","importances = {} # feature importances { (col, model, window): series }\n","\n","print(\"=\" * 70)\n","print(\"ML TRAINING PIPELINE — XGBoost and Random Forest\")\n","print(\"=\" * 70)\n","\n","for group_name, series_list in GROUPS.items():\n","\n","    group_cols = [s[0] for s in series_list]\n","\n","    print(f\"\\n{'═'*65}\")\n","    print(f\"GROUP: {group_name}  |  Series: {group_cols}\")\n","    print(f\"{'═'*65}\")\n","\n","    for target_col, label, color in series_list:\n","\n","        print(f\"\\n{'─'*55}\")\n","        print(f\"Target: {label}  ({target_col})\")\n","\n","        for win_key, (train_start, train_end) in WINDOWS.items():\n","\n","            print(f\"\\n  Window: {win_key}  ({train_start[:7]} → {train_end[:7]})\")\n","\n","            # ── Build full feature matrix ─────────────────────────────────────\n","            feat_df = build_features(panel, target_col, group_cols)\n","\n","            # ── Split into train / test ───────────────────────────────────────\n","            train_mask = (\n","                (feat_df['date'] >= train_start) &\n","                (feat_df['date'] <= train_end)\n","            )\n","            test_mask  = (\n","                (feat_df['date'] >= TEST_START) &\n","                (feat_df['date'] <= TEST_END)\n","            )\n","\n","            df_train = feat_df[train_mask].copy()\n","            df_test  = feat_df[test_mask].copy()\n","\n","            if len(df_train) < 24 or len(df_test) == 0:\n","                print(f\"    SKIP — N_train={len(df_train)}, N_test={len(df_test)}\")\n","                continue\n","\n","            # ── Feature and target arrays ─────────────────────────────────────\n","            feat_cols = [\n","                c for c in feat_df.columns\n","                if c not in ['date', 'target']\n","            ]\n","\n","            X_train = df_train[feat_cols].values\n","            y_train = df_train['target'].values\n","            X_test  = df_test[feat_cols].values\n","            y_test  = df_test['target'].values\n","            dates   = df_test['date'].values\n","\n","            # Standardise (fit on training set only)\n","            scaler   = StandardScaler()\n","            X_train_s = scaler.fit_transform(X_train)\n","            X_test_s  = scaler.transform(X_test)\n","\n","            print(f\"    N_train={len(X_train)}  N_test={len(X_test)}  \"\n","                  f\"N_features={len(feat_cols)}\")\n","\n","            for model_name, ModelClass, params in [\n","                ('XGBoost',      XGBRegressor,          XGB_PARAMS),\n","                ('RandomForest', RandomForestRegressor, RF_PARAMS),\n","            ]:\n","                # ── Walk-forward CV ───────────────────────────────────────────\n","                cv_score = walkforward_cv(\n","                    X_train_s, y_train,\n","                    ModelClass, params,\n","                    n_splits=N_SPLITS\n","                )\n","\n","                # ── Final model on full training window ───────────────────────\n","                model = ModelClass(**params)\n","                model.fit(X_train_s, y_train)\n","\n","                # ── Test forecast ─────────────────────────────────────────────\n","                yhat = model.predict(X_test_s)\n","\n","                # ── Metrics ───────────────────────────────────────────────────\n","                skip_mape = (target_col in MAPE_EXCLUDE)\n","                m_val  = mape(y_test, yhat) if not skip_mape else None\n","                r_val  = rmse(y_test, yhat)\n","                ma_val = mae_fn(y_test, yhat)\n","\n","                thr    = MAPE_THRESHOLD.get(target_col, 12.0)\n","                status = ''\n","                if not skip_mape:\n","                    status = '\\u2714' if m_val <= thr else '\\u2718'\n","                    print(f\"    [{model_name:<14}] CV={cv_score:.2f}%  \"\n","                          f\"MAPE={m_val:.4f}%  RMSE={r_val:.4f}  \"\n","                          f\"MAE={ma_val:.4f}  {status}\")\n","                else:\n","                    print(f\"    [{model_name:<14}] CV={cv_score:.2f}  \"\n","                          f\"RMSE={r_val:.4f}  MAE={ma_val:.4f}  \"\n","                          f\"(MAPE excluded)\")\n","\n","                # ── Feature importance ────────────────────────────────────────\n","                if hasattr(model, 'feature_importances_'):\n","                    imp = pd.Series(\n","                        model.feature_importances_,\n","                        index=feat_cols\n","                    ).sort_values(ascending=False)\n","                    importances[(target_col, model_name, win_key)] = imp\n","\n","                # ── Store results ─────────────────────────────────────────────\n","                results.append({\n","                    'Group'       : group_name,\n","                    'Series'      : label,\n","                    'Column'      : target_col,\n","                    'Model'       : model_name,\n","                    'Window'      : win_key,\n","                    'N_train'     : len(X_train),\n","                    'N_test'      : len(X_test),\n","                    'N_features'  : len(feat_cols),\n","                    'CV_score'    : round(cv_score, 4),\n","                    'MAPE'        : round(m_val, 4) if m_val else None,\n","             