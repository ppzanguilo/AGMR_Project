=====================================================================\n","  CPI Inflation                XGBoost        MAPE= 19.2454%  <   5.0%  ✘ Not met\n","  CPI Inflation                RandomForest   MAPE= 16.5194%  <   5.0%  ✘ Not met\n","  USD/AOA Exchange Rate        XGBoost        MAPE= 17.4633%  <  10.0%  ✘ Not met\n","  USD/AOA Exchange Rate        RandomForest   MAPE= 22.6601%  <  10.0%  ✘ Not met\n","  Real Interest Rate           XGBoost        MAPE excluded  MAE=2.4615  RMSE=3.8751\n","  Real Interest Rate           RandomForest   MAPE excluded  MAE=2.8705  RMSE=4.0666\n","  Brent Crude Oil              XGBoost        MAPE=  8.4172%  <  12.0%  ✔ Met\n","  Brent Crude Oil              RandomForest   MAPE=  6.2317%  <  12.0%  ✔ Met\n","  Natural Gas (EU)             XGBoost        MAPE= 25.9742%  <  12.0%  ✘ Not met\n","  Natural Gas (EU)             RandomForest   MAPE= 24.8856%  <  12.0%  ✘ Not met\n","  Diamond Index                XGBoost        MAPE=  2.2572%  <  12.0%  ✔ Met\n","  Diamond Index                RandomForest   MAPE=  1.8820%  <  12.0%  ✔ Met\n","  Gold PPI                     XGBoost        MAPE= 16.9560%  <  12.0%  ✘ Not met\n","  Gold PPI                     RandomForest   MAPE= 15.2948%  <  12.0%  ✘ Not met\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"RL2PtJ-8-nnT"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Diebold–Mariano test\n","\n","def diebold_mariano(e1, e2, loss='squared', h=1):\n","    \"\"\"\n","    Diebold-Mariano test for equal predictive accuracy.\n","    H0: E[L(e1)] = E[L(e2)]\n","    Ha: E[L(e1)] < E[L(e2)]  (one-sided: model 1 better than model 2)\n","\n","    Parameters\n","    ----------\n","    e1, e2 : forecast error arrays for model 1 and model 2\n","    loss   : 'squared' (MSE-based) or 'absolute' (MAE-based)\n","    h      : forecast horizon (1 for one-step-ahead)\n","\n","    Returns\n","    -------\n","    dm_stat : DM test statistic\n","    p_value : one-sided p-value (H0: equal; Ha: model 1 better)\n","    \"\"\"\n","    if loss == 'squared':\n","        d = e1**2 - e2**2\n","    else:\n","        d = np.abs(e1) - np.abs(e2)\n","\n","    n    = len(d)\n","    dbar = np.mean(d)\n","\n","    # HAC variance (Newey-West with lag = h-1)\n","    gamma0 = np.var(d, ddof=1)\n","    nw_var = gamma0\n","    for k in range(1, h):\n","        gamma_k = np.mean((d[k:] - dbar) * (d[:-k] - dbar))\n","        nw_var += 2 * (1 - k / h) * gamma_k\n","    nw_var = max(nw_var, 1e-10)\n","\n","    dm_stat = dbar / np.sqrt(nw_var / n)\n","    # One-sided: Ha: model 1 has lower loss → dm_stat < 0 → p = Φ(dm_stat)\n","    p_value = scipy_stats.norm.cdf(dm_stat)\n","\n","    return round(float(dm_stat), 4), round(float(p_value), 4)\n","\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"DIEBOLD–MARIANO TEST — ML vs ARIMA (H0: equal MAPE; Ha: ML better)\")\n","print(\"One-sided test at α = 0.05  |  Reject H0 if p < 0.05\")\n","print(\"=\" * 80)\n","print(f\"\\n  {'Series':<28} {'Model':<14} {'Window':<14} \"\n","      f\"{'DM stat':>9} {'p-value':>9} {'Result':<20}\")\n","print(\"  \" + \"─\" * 75)\n","\n","dm_rows = []\n","\n","for _, r in df_res.iterrows():\n","    if r['Column'] in MAPE_EXCLUDE:\n","        continue\n","\n","    # Get ML forecast errors\n","    ml_fc = df_fc[\n","        (df_fc['Column']  == r['Column']) &\n","        (df_fc['Model']   == r['Model'])  &\n","        (df_fc['Window']  == r['Window'])\n","    ].sort_values('Date')\n","\n","    # Get ARIMA forecast errors for the same series\n","    # Match by series label and test dates\n","    arima_series = arima_fc[arima_fc['Series'] == r['Series']].copy()\n","    if hasattr(arima_series['Date'], 'dt'):\n","        arima_series['Date_str'] = arima_series['Date'].dt.strftime('%Y-%m')\n","    else:\n","        arima_series['Date_str'] = arima_series['Date'].astype(str).str[:7]\n","\n","    merged = pd.merge(\n","        ml_fc[['Date','Actual','Error']].rename(columns={'Error':'ml_error'}),\n","        arima_series[['Date_str','Error']].rename(\n","            columns={'Date_str':'Date','Error':'arima_error'}\n","        ),\n","        on='Date', how='inner'\n","    )\n","\n","    if len(merged) < 10:\n","        continue\n","\n","    e_ml    = merged['ml_error'].values\n","    e_arima = merged['arima_error'].values\n","\n","    dm, pv = diebold_mariano(e_ml, e_arima, loss='absolute')\n","\n","    decision = '\\u2714 Reject H0 — ML better' if pv < 0.05 else 'Fail to reject H0'\n","    print(f\"  {r['Series']:<28} {r['Model']:<14} {r['Window']:<14} \"\n","          f\"{dm:>9.4f} {pv:>9.4f}  {decision}\")\n","\n","    dm_rows.append({\n","        'Series'   : r['Series'],\n","        'Model'    : r['Model'],\n","        'Window'   : r['Window'],\n","        'DM_stat'  : dm,\n","        'p_value'  : pv,\n","        'Reject_H0': pv < 0.05,\n","    })\n","\n","pd.DataFrame(dm_rows).to_csv(\n","    os.path.join(OUTPUT_DIR, 'diebold_mariano.csv'), index=False\n",")\n","print(f\"\\nSaved → diebold_mariano.csv\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"veK_5-pq-npp","executionInfo":{"status":"ok","timestamp":1778454079837,"user_tz":-60,"elapsed":242,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"eeafa3eb-a2d0-42cf-e8ca-25426ad94ef7"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","================================================================================\n","DIEBOLD–MARIANO TEST — ML vs ARIMA (H0: equal MAPE; Ha: ML better)\n","One-sided test at α = 0.05  |  Reject H0 if p < 0.05\n","================================================================================\n","\n","  Series                       Model          Window           DM stat   p-value Result              \n","  ───────────────────────────────────────────────────────────────────────────\n","  CPI Inflation                XGBoost        full_sample      -6.2636    0.0000  ✔ Re