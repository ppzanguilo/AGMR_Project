null,"outputs":[]},{"cell_type":"code","source":["DATA_DIR = '/content/drive/MyDrive/AGMR/timeseries/raw'\n","\n","OUTPUT_DIR = '/content/drive/MyDrive/AGMR/outputs/arima'\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","\n","PANEL_FILE = os.path.join(DATA_DIR, 'agmr_panel_7series_monthly.csv')\n"],"metadata":{"id":"YxuUEJ6zk0rI"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"2po4ApiWoUkj"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# Configuration — windows, models, thresholds\n","\n","\n","# Training / test windows\n","WINDOWS = {\n","    'full_sample' : ('1995-01-01', '2020-12-01'),\n","    'post_2002'   : ('2003-01-01', '2020-12-01'),   # CPI only\n","    'post_2014'   : ('2014-01-01', '2020-12-01'),\n","}\n","TEST_START = '2021-01-01'\n","TEST_END   = '2025-12-01'\n","\n","# ── ARIMA orders per series per window ───────────────────────────────────────\n","# Format: { col : { window_key: (p,d,q) } }\n","# Where window_key matches keys in WINDOWS dict\n","# 'grid' triggers AIC search for that window\n","ARIMA_SPEC = {\n","    'cpi_inflation_pct': {\n","        'full_sample' : (1, 1, 0),\n","        'post_2002'   : (1, 0, 0),   # post-2002: borderline I(0)\n","        'post_2014'   : (1, 1, 0),\n","    },\n","    'usd_aoa_monthly': {\n","        'full_sample' : (1, 1, 1),\n","        'post_2014'   : (1, 1, 1),\n","    },\n","    'real_interest_rate_monthly': {\n","        'full_sample' : (0, 1, 0),\n","        'post_2014'   : (0, 1, 0),\n","    },\n","    'oil_brent_usd_bbl': {\n","        'full_sample' : (1, 1, 0),\n","        'post_2014'   : (1, 1, 0),\n","    },\n","    'nat_gas_usd_mmbtu': {\n","        'full_sample' : 'grid',       # AIC grid over p,q ∈ {0–4}\n","        'post_2014'   : 'grid',\n","    },\n","    'diamond_usd_carat': {\n","        'full_sample' : (1, 1, 1),\n","        # No post-2014 model: no confirmed structural break\n","    },\n","    'gold_usd': {\n","        'full_sample' : (1, 2, 0),    # I(2) series\n","        'post_2014'   : (1, 2, 0),\n","    },\n","}\n","\n","# ── AIC grid search space for Natural Gas ─────────────────────────────────────\n","GAS_GRID = {\n","    'p': list(range(0, 5)),\n","    'd': [1],\n","    'q': list(range(0, 5)),\n","}\n","\n","# ── Deployment MAPE thresholds ────────────────────────────────────────────────\n","MAPE_THRESHOLD = {\n","    'cpi_inflation_pct'          : 5.0,\n","    'usd_aoa_monthly'            : 10.0,\n","    'real_interest_rate_monthly' : 8.0,\n","    'oil_brent_usd_bbl'          : 12.0,\n","    'nat_gas_usd_mmbtu'          : 12.0,\n","    'diamond_usd_carat'          : 12.0,\n","    'gold_usd'                   : 12.0,\n","}\n","\n","# ── Series display metadata ───────────────────────────────────────────────────\n","META = {\n","    'cpi_inflation_pct'          : ('CPI Inflation',          '#1F3864'),\n","    'usd_aoa_monthly'            : ('USD/AOA Exchange Rate',  '#1F3864'),\n","    'real_interest_rate_monthly' : ('Real Interest Rate',     '#1F3864'),\n","    'oil_brent_usd_bbl'          : ('Brent Crude Oil',        '#922B21'),\n","    'nat_gas_usd_mmbtu'          : ('Natural Gas (EU)',        '#922B21'),\n","    'diamond_usd_carat'          : ('Diamond Index',          '#922B21'),\n","    'gold_usd'                   : ('Gold PPI',               '#922B21'),\n","}\n","\n","plt.rcParams.update({\n","    'font.family'       : 'DejaVu Sans',\n","    'axes.spines.top'   : False,\n","    'axes.spines.right' : False,\n","    'axes.grid'         : True,\n","    'grid.linestyle'    : ':',\n","    'grid.alpha'        : 0.35,\n","})\n","\n","print(\"Configuration set ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"t70EOBFsoUnv","executionInfo":{"status":"ok","timestamp":1778444968568,"user_tz":-60,"elapsed":20,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"e269951a-09f5-4e0d-ae2e-5ae916f40640"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Configuration set ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"Jgik76Q1oUqu"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Load and prepare data\n","\n","panel = pd.read_csv(PANEL_FILE, parse_dates=['date'])\n","panel = panel.sort_values('date').reset_index(drop=True)\n","\n","test_mask = (panel['date'] >= TEST_START) & (panel['date'] <= TEST_END)\n","test      = panel[test_mask].copy().reset_index(drop=True)\n","\n","print(f\"Panel loaded: {panel.shape[0]} rows\")\n","print(f\"Test set    : {test['date'].min().strftime('%Y-%m')} → \"\n","      f\"{test['date'].max().strftime('%Y-%m')}  (n = {len(test)})\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"14ArAKMCoUvF","executionInfo":{"status":"ok","timestamp":1778444976920,"user_tz":-60,"elapsed":503,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"e464dc32-1dd6-421b-9c92-574acd8538e0"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Panel loaded: 2321 rows\n","Test set    : 2021-01 → 2025-12  (n = 60)\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"6PSwvCBvoUzj"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Helper functions\n","\n","def get_train(col, window_key):\n","    \"\"\"Extract training series for a given window key.\"\"\"\n","    start, end = WINDOWS[window_key]\n","    mask = (panel['date'] >= start) & (panel['date'] <= end)\n","    return panel.loc[mask, col].dropna().reset_index(drop=True)\n","\n","\n","def get_test(col):\n","    \"\"\"Extract test series (2021–2025).\"\"\"\n","    return test[col].dropna().reset_index(drop=True)\n","\n","\n","def mape(y, yhat):\n","    y, yhat = np.array(y), np.array(yhat)\n","    mask = y != 0\n","    return float(100 * np.mean(np.abs((y[mask] - yhat[mask]) / y[mask])))\n","\n","\n","def rmse(y, yhat):\n","    return float(np.sqrt(np.mean((np.array(y) - np.array(yhat)) ** 2)))\n","\n","\n","def mae_metric(y, yhat):\n","    return float(np.mean(np.abs(np.array(y) - np.array(yhat))))\n","\n","\n","def aic_grid_search(train_series, p_range, d_range, q_range, label=''):\n","    \"\"\"\n","    Grid search over ARIMA(p,d,q) combinations.\n","    Returns best order and full AIC table sorted ascending.\n","    \"\"\"\n","    results = []\n","    combos  = list(itertools.product(p_range, d_range, q_range))\n","    print(f\"  Grid search: {len(combos)} combinations for {label}...\")\n","\n","    for p, d, q in combos:\n","        try:\n","            fit = ARIMA(train_series, order=(p, d, q)).fit()\n","            results.append({'p': p, 'd': d, 'q': q, 'AIC': round(fit.aic, 4)})\n","        except Exception:\n","            continue\n","\n","    if not results:\n","        print(f\"  WARNING: No valid model found, defaulting to ARIMA(2,1,0)\")\n","        return (2, 1, 0), pd.DataFrame()\n","\n","    df_res  = pd.DataFrame(results).sort_values('AIC').reset_index(drop=True)\n","    best    = tuple(df_res.iloc[0][['p', 'd', 'q']].astype(int))\n","    print(f\"  Best: ARIMA{best}  AIC = {df_res.iloc[0]['AIC']:.4f}\")\n","    print(f\"  Top 5:\\n{df_res.head(5).to_string(index=False)}\")\n","    return best, df_res\n","\n","\n","def fit_forecast(train_series, test_series, order, label, window):\n","    \"\"\"\n","    Fit ARIMA(order) on train, forecast len(test) steps ahead.\n","    Returns metrics dict, forecast array, confidence intervals.\n","    \"\"\"\n","    try:\n","        model = ARIMA(train_series, order=order).fit()\n","        fc    = model.get_forecast(steps=len(test_series))\n","        yhat  = fc.predicted_mean.values\n","        ci    = fc.conf_int(alpha=0.05)\n","        y     = test_series.values\n","\n","        metrics = {\n","            'Series'  : label,\n","            'Window'  : window,\n","            'Order'   : f'ARIMA{order}',\n","            'N_train' : len(train_series),\n","            'N_test'  : len(test_series),\n","            'AIC'     : round(model.aic, 4),\n","            'MAPE'    : round(mape(y, yhat), 4),\n","            'RMSE'    : round(rmse(y, yhat), 4),\n","            'MAE'     : round(mae_metric(y, yhat), 4),\n","        }\n","        return metrics, yhat, ci, model\n","\n","    except Exception as e:\n","        print(f\"  ERROR fitting ARIMA{order} for {label} ({window}): {e}\")\n","        return None, None, None, None\n","\n","\n","print(\"Helper functions defined ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"slUqO6JKoU2w","executionInfo":{"status":"ok","timestamp":1778444980906,"user_tz":-60,"elapsed":127,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"f6900222-8f05-44f3-8c6c-67cd78d94ad7"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Helper functions defined ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"QUj2kc4QoU4W"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Main estimation loop\n","\n","metrics_rows = []\n","forecast_store = {}    # { (col, window_key): {'yhat':..,'ci':..,'y':..,'dates':..} }\n","model_store    = {}    # { (col, window_key): fitted ARIMA model }\n","order_log      = {}    # { (col, window_key): (p,d,q) }\n","\n","print(\"=\" * 70)\n","print(\"ARIMA ESTIMATION PIPELINE\")\n","print(\"=\" * 70)\n","\n","for col, windows_for_col in ARIMA_SPEC.items():\n","    label, color = META[col]\n","    y_test = get_test(col)\n","\n","    print(f\"\\n{'─'*60}\")\n","    print(f\"Series: {label}  |  Test n = {len(y_test)}\")\n","\n","    for win_key, spec in windows_for_col.items():\n","\n","        train = get_train(col, win_key)\n","        if len(train) < 24:\n","            print(f\"  [{win_key}] Skipped — insufficient training data ({len(train)} obs)\")\n","            continue\n","\n","        # ── Resolve order (grid or fixed) ─────────────────────────────────────\n","        if spec == 'grid':\n","            order, aic_table = aic_grid_search(\n","                train,\n","                GAS_GRID['p'], GAS_GRID['d'], GAS_GRID['q'],\n","                label=f\"{label} ({win_key})\"\n","            )\n","            # Save AIC table for natural gas\n","            aic_path = os.path.join(\n","                OUTPUT_DIR, f\"aic_grid_{col}_{win_key}.csv\"\n","            )\n","            aic_table.to_csv(aic_path, index=False)\n","        else:\n","            order = spec\n","            print(f\"  [{win_key}] Fixed order: ARIMA{order}  \"\n","                  f\"N_train = {len(train)}\")\n","\n","        order_log[(col, win_key)] = order\n","\n","        # ── Fit and forecast ──────────────────────────────────────────────────\n","        m, yhat, ci, fitted = fit_forecast(\n","            train, y_test, order, label, win_key.replace('_', ' ')\n","        )\n","\n","        if m is None:\n","            continue\n","\n","        metrics_rows.append(m)\n","        model_store[(col, win_key)] = fitted\n","\n","        # Store forecast for plotting\n","        test_dates = test.loc[\n","            test[col].notna(), 'date'\n","        ].reset_index(drop=True)\n","\n","        forecast_store[(col, win_key)] = {\n","            'yhat'  : yhat,\n","            'ci'    : ci,\n","            'y'     : y_test.values,\n","            'dates' : test_dates,\n","            'order' : order,\n","        }\n","\n","        print(f\"  [{win_key}] ARIMA{order}  \"\n","              f\"MAPE={m['MAPE']:.4f}%  RMSE={m['RMSE']:.4f}  \"\n","              f\"MAE={m['MAE']:.4f}  AIC={m['AIC']:.4f}\")\n","\n","# ── Build results table ───────────────────────────────────────────────────────\n","metrics_df = pd.DataFrame(metrics_rows)\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"ARIMA RESULTS TABLE — MAPE / RMSE / MAE  (test set 2021–2025)\")\n","print(\"=\" * 80)\n","print(metrics_df.to_string(index=False))\n","\n","# Save\n","metrics_df.to_csv(os.path.join(OUTPUT_DIR, 'arima_metrics.csv'), index=False)\n","\n","order_records = [\n","    {'Series': META[col][0], 'Window': w.replace('_', ' '), 'Order': str(v)}\n","    for (col, w), v in order_log.items()\n","]\n","pd.DataFrame(order_records).to_csv(\n","    os.path.join(OUTPUT_DIR, 'arima_orders.csv'), index=False\n",")\n","print(f\"\\nSaved → {os.path.join(OUTPUT_DIR, 'arima_metrics.csv')}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"tFRmsptrk0tw","executionInfo":{"status":"ok","timestamp":1778444999380,"user_tz":-60,"elapsed":14811,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"73656794-58be-4331-b113-7444a5666c09"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","ARIMA ESTIMATION PIPELINE\n","======================================================================\n","\n","────────────────────────────────────────────────────────────\n","Series: CPI Inflation  |  Test n = 60\n","  [full_sample] Fixed order: ARIMA(1, 1, 0)  N_train = 312\n","  [full_sample] ARIMA(1, 1, 0)  MAPE=54.3560%  RMSE=0.7291  MAE=0.5782  AIC=2152.5237\n","  [post_2002] Fixed order: ARIMA(1, 0, 0)  N_train = 216\n","  [post_2002] ARIMA(1, 0, 0)  MAPE=42.5320%  RMSE=0.5884  MAE=0.4864  AIC=388.6393\n","  [post_2014] Fixed order: ARIMA(1, 1, 0)  N_train = 84\n","  [post_2014] ARIMA(1, 1, 0)  MAPE=54.4948%  RMSE=0.7311  MAE=0.5794  AIC=102.3198\n","\n","────────────────────────────────────────────────────────────\n","Series: USD/AOA Exchange Rate  |  Test n = 60\n","  [full_sample] Fixed order: ARIMA(1, 1, 1)  N_train = 312\n","  [full_sample] ARIMA(1, 1, 1)  MAPE=50.2139%  RMSE=343.5097  MAE=316.7030  AIC=1986.3195\n","  [post_2014] Fixed order: ARIMA(1, 1, 1)  N_train = 84\n","  [post_2014] ARIMA(1, 1, 1)  MAPE=40.8085%  RMSE=273.0564  MAE=243.4026  AIC=642.9032\n","\n","────────────────────────────────────────────────────