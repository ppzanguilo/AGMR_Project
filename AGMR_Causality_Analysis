         → Real Interest Ra      0.9996       0.9699  — Unchanged\n","  Real Interest Ra → CPI Inflation         0.0267       0.0257  — Unchanged\n","  Real Interest Ra → USD/AOA               0.9998       0.9003  — Unchanged\n","\n","  Brent Crude Oil  → Natural Gas (EU)      0.0000       0.0000  — Confirmed again\n","  Brent Crude Oil  → Diamond Index         0.0066       0.0005  ✔ Now significant\n","  Natural Gas (EU) → Diamond Index         0.0003       0.0818  ✘ Lost significance\n","  Natural Gas (EU) → Brent Crude Oil       0.1241       0.1443  — Unchanged\n","  Diamond Index    → Gold PPI              0.0077       0.0826  — Unchanged\n","  Gold PPI         → Brent Crude Oil       0.0895       0.1279  — Unchanged\n","\n","======================================================================\n","FINAL RQ5 ANSWER — VECM / VAR LEVELS SPECIFICATION\n","======================================================================\n","\n","  Macroeconomic Group (VAR in Levels, α* = 0.0083):\n","    ✔ CPI Inflation → Real Interest Rate  (F=3.388, p=0.0030)\n","\n","  Commodity Group (VECM coint_rank=1, α* = 0.0042):\n","    ✔ Brent Crude Oil → Natural Gas (EU)  (F=14.077, p=0.0000)\n","    ✔ Brent Crude Oil → Diamond Index  (F=5.216, p=0.0005)\n","\n","Outputs saved to: /content/drive/MyDrive/AGMR/outputs/granger\n","  fevd_commodity.png                                        117,802 bytes\n","  fevd_commodity_vecm.png                                   102,862 bytes\n","  fevd_macroeconomic.png                                     98,370 bytes\n","  fevd_macroeconomic_levels.png                              84,742 bytes\n","  granger_heatmaps.png                                      182,012 bytes\n","  granger_intergroup.csv                                      2,579 bytes\n","  granger_intergroup_heatmap.png                            167,744 bytes\n","  granger_results.csv                                         1,288 bytes\n","  irf_commodity.png                                         784,039 bytes\n","  irf_commodity_vecm.png                                    382,341 bytes\n","  irf_macroeconomic.png                                     373,323 bytes\n","  irf_macroeconomic_levels.png                              329,232 bytes\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"rC-W2L50Cj7V"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# =============================================================================\n","# GMR — VECM Inter-Group Granger Causality\n","# Augmented test controlling for within-group dynamics\n","#\n","# Method:\n","#   Macro group  → VAR in levels  (r=3, Johansen full rank)\n","#   Commodity group → VECM short-run (first differences + ECT)\n","#\n","# For each cross-group pair (X → Y):\n","#   Restricted   : Y ~ Y_own_lags + Y_group_controls\n","#   Unrestricted : Y ~ Y_own_lags + Y_group_controls + X_lags\n","#   F-test on X_lags block (controls for within-group structure)\n","#\n","# 24 pairs  |  Bonferroni α* = 1.2 / 24 = 0.05\n","# =============================================================================\n","\n","\n","# ── Series configuration ──────────────────────────────────────────────────────\n","MACRO_COLS  = ['cpi_inflation_pct', 'usd_aoa_monthly',\n","               'real_interest_rate_monthly']\n","MACRO_LABS  = ['CPI Inflation', 'USD/AOA', 'Real Interest Rate']\n","P_MACRO     = 6   # VAR(6) in levels\n","\n","COMM_COLS   = ['oil_brent_usd_bbl', 'nat_gas_usd_mmbtu',\n","               'diamond_usd_carat', 'gold_usd']\n","COMM_LABS   = ['Brent Crude Oil', 'Natural Gas (EU)',\n","               'Diamond Index', 'Gold PPI']\n","P_COMM      = 4   # VECM k_ar_diff=3 → test at 4 lags\n","\n","N_PAIRS    = len(MACRO_COLS) * len(COMM_COLS) * 2   # 24\n","ALPHA_BONF = round(1.2 / N_PAIRS, 4)               # 0.05\n","print(f\"Inter-group pairs: {N_PAIRS}  |  Bonferroni α* = {ALPHA_BONF}\")\n","\n","# ── Data preparation ──────────────────────────────────────────────────────────\n","# Macro  : levels (VAR in levels is correct specification)\n","# Comm   : first differences (VECM short-run)  + ΔGold already I(1)\n","macro_data = train[MACRO_COLS].dropna().copy()\n","\n","comm_levels = train[COMM_COLS].copy()\n","comm_diff   = comm_levels.diff()\n","comm_diff['gold_usd'] = comm_levels['gold_usd'].diff()  # ΔGold (I(1) proxy)\n","comm_diff   = comm_diff.dropna()\n","\n","# ── Error correction term (ECT) from Commodity VECM ──────────────────────────\n","# β = [1.0000, -6.9487, -2.0623, -3.5388] (from VECM output)\n","beta = np.array([1.0000, -6.9487, -2.0623, -3.5388])\n","ect  = (comm_levels[COMM_COLS] @ beta).rename('ect')\n","ect  = ect.loc[comm_diff.index]   # align index after differencing\n","\n","# ── Augmented Granger test function ──────────────────────────────────────────\n","def build_lagged_matrix(series_df, cols, lags, suffix=''):\n","    \"\"\"Build a matrix of lagged values for given columns and lag depths.\"\"\"\n","    frames = []\n","    for lag in range(1, lags + 1):\n","        block = series_df[cols].shift(lag)\n","        block.columns = [f\"{c}_L{lag}{suffix}\" for c in cols]\n","        frames.append(block)\n","    return pd.concat(frames, axis=1)\n","\n","\n","def augmented_granger_f(effect_df, effect_col, group_cols,\n","                        cause_series, lags, ect_series=None):\n","    \"\"\"\n","    F-test for augmented Granger causality: cause → effect.\n","\n","    Restricted   : effect_col ~ own_lags + group_lags [+ ECT]\n","    Unrestricted : restricted + cause_lags\n","    Returns: (F_stat, p_value, n_obs)\n","    \"\"\"\n","    # Own lags of effect variable\n","    y_lags = build_lagged_matrix(effect_df, [effect_col], lags)\n","\n","    # Within-group control lags (other series in same group)\n","    ctrl_cols = [c for c in group_cols if c != effect_col]\n","    if ctrl_cols:\n","        g_lags = build_lagged_matrix(effect_df, ctrl_cols, lags)\n","    else:\n","        g_lags = pd.DataFrame(index=effect_df.index)\n","\n","    # Cause lags (cross-group)\n","    cause_df = pd.DataFrame({'_cause': cause_series})\n","    c_lags   = build_lagged_matrix(cause_df, ['_cause'], lags)\n","\n","    # Combine and drop NaN\n","    base = pd.concat([effect_df[[effect_col]], y_lags, g_lags], axis=1)\n","    if ect_series is not None:\n","        base['_ect'] = ect_series\n","\n","    full = pd.concat([base, c_lags], axis=1).dropna()\n","\n","    y_col    = effect_col\n","    y        = full[y_col].values\n","\n","    # Restricted feature set\n","    r_cols   = [c for c in full.columns\n","                if c != y_col and not c.startswith('_cause')]\n","    X_r      = full[r_cols].values\n","\n","    # Unrestricted feature set (add cause lags)\n","    u_cols   = r_cols + [c for c in full.columns if c.startswith('_cause')]\n","    X_u      = full[u_cols].values\n","\n","    n        = len(y)\n","    k_r      = X_r.shape[1]\n","    k_u      = X_u.shape[1]\n","    p        = k_u - k_r   # number of restrictions = lags of cause\n","\n","    if n < k_u + 5:\n","        return np.nan, np.nan, n\n","\n","    # OLS residuals\n","    def ols_ssr(X, y):\n","        coef = np.linalg.lstsq(\n","            np.column_stack([np.ones(len(X)), X]), y, rcond=None\n","        )[0]\n","        yhat = np.column_stack([np.ones(len(X)), X]) @ coef\n","        return np.sum((y - yhat) ** 2)\n","\n","    ssr_r = ols_ssr(X_r, y)\n","    ssr_u = ols_ssr(X_u, y)\n","\n","    if ssr_u < 1e-12 or p == 0:\n","        return np.nan, np.nan, n\n","\n","    F_stat = ((ssr_r - ssr_u) / p) / (ssr_u / (n - k_u - 1))\n","    p_val  = 1 - f_dist.cdf(F_stat, dfn=p, dfd=n - k_u - 1)\n","\n","    return float(F_stat), float(p_val), n\n","\n","\n","# ── Run all 24 cross-group pairs ──────────────────────────────────────────────\n","print(f\"\\n{'Cause':<28} {'Effect':<28} \"\n","      f\"{'F-stat':>8} {'p-value':>10} {'α*':>8}  Result\")\n","print(\"─\" * 86)\n","\n","records = []\n","\n","# Direction 1: Macro → Commodity\n","for ci, cl in zip(MACRO_COLS, MACRO_LABS):\n","    for ej, el in zip(COMM_COLS, COMM_LABS):\n","        F, p, n = augmented_granger_f(\n","            effect_df    = comm_diff,\n","            effect_col   = ej,\n","            group_cols   = COMM_COLS,\n","            cause_series = macro_data[ci],\n","            lags         = P_COMM,\n","            ect_series   = ect,\n","        )\n","        reject = (p < ALPHA_BONF) if not np.isnan(p) else False\n","        flag   = '✔ REJECT H₀' if reject else '  n.s.'\n","        p_str  = f\"{p:.4f}\" if not np.isnan(p) else 'n/a'\n","        F_str  = f\"{F:.3f}\"  if not np.isnan(F) else 'n/a'\n","        print(f\"  {cl:<26} {el:<26} {F_str:>8} {p_str:>10} \"\n","              f\"{ALPHA_BONF:>8.4f}  {flag}\")\n","        records.append({\n","            'Direction'  : 'Macro → Commodity',\n","            'Cause'      : cl, 'Cause_col'  : ci,\n","            'Effect'     : el, 'Effect_col' : ej,\n","            'F_stat'     : round(F, 4) if not np.isnan(F) else None,\n","            'p_value'    : round(p, 4) if not np.isnan(p) else None,\n","            'alpha_bonf' : ALPHA_BONF,\n","            'Reject_H0'  : reject,\n","        })\n","\n","print()\n","\n","# Direction 2: Commodity → Macro\n","for ci, cl in zip(COMM_COLS, COMM_LABS):\n","    for ej, el in zip(MACRO_COLS, MACRO_LABS):\n","        F, p, n = augmented_granger_f(\n","            effect_df    = macro_data,\n","            effect_col   = ej,\n","            group_cols   = MACRO_COLS,\n","            cause_series = comm_diff[ci],\n","            lags         = P_MACRO,\n","            ect_series   = None,   # ECT belongs to commodity, not macro\n","        )\n","        reject = (p < ALPHA_BONF) if not np.isnan(p) else False\n","        flag   = '✔ REJECT H₀' if reject else '  n.s.'\n","        p_str  = f\"{p:.4f}\" if not np.isnan(p) else 'n/a'\n","        F_str  = f\"{F:.3f}\"  if not np.isnan(F) else 'n/a'\n","        print(f\"  {cl:<26} {el:<26} {F_str:>8} {p_str:>10} \"\n","              f\"{ALPHA_BONF:>8.4f}  {flag}\")\n","        records.append({\n","            'Direction'  : 'Commodity → Macro',\n","            'Cause'      : cl, 'Cause_col'  : ci,\n","            'Effect'     : el, 'Effect_col' : ej,\n","            'F_stat'     : round(F, 4) if not np.isnan(F) else None,\n","            'p_value'    : round(p, 4) if not np.isnan(p) else None,\n","            'alpha_bonf' : ALPHA_BONF,\n","            'Reject_H0'  : reject,\n","        })\n","\n","# ── Save CSV ──────────────────────────────────────────────────────────────────\n","df_ig = pd.DataFrame(records)\n","df_ig.to_csv(\n","    os.path.join(OUTPUT_DIR, 'granger_intergroup_vecm.csv'), index=False\n",")\n","\n","# ── Heatmaps ──────────────────────────────────────────────────────────────────\n","fig, axes = plt.subplots(1, 2, figsize=(16, 6), facecolor='#F8F9FA')\n","fig.suptitle(\n","    'Inter-Group Granger Causality — Augmented VECM Test\\n'\n","    f'Bonferroni α* = {ALPHA_BONF}  '\n","    f'(Macro: VAR in Levels  |  Commodity: VECM + ECT)  |  '\n","    'Green = confirmed at α*',\n","    fontsize=11, fontweight='bold', color='#1F3864', y=1.04\n",")\n","\n","for ax, direction, row_labs, col_labs, row_key, col_key, title_color in [\n","    (axes[0], 'Macro → Commodity',\n","     MACRO_LABS, COMM_LABS, 'Cause', 'Effect', '#1F3864'),\n","    (axes[1], 'Commodity → Macro',\n","     COMM_LABS, MACRO_LABS, 'Cause', 'Effect', '#922B21'),\n","]:\n","    subset = df_ig[df_ig['Direction'] == direction]\n","    nr, nc = len(row_labs), len(col_labs)\n","    matrix = np.full((nr, nc), np.nan)\n","\n","    for _, row in subset.iterrows():\n","        ri = row_labs.index(row['Cause'])\n","        ci = col_labs.index(row['Effect'])\n","        matrix[ri, ci] = row['p_value'] if row['p_value'] is not None else 1.0\n","\n","    im = ax.imshow(matrix, cmap='RdYlGn_r', vmin=0, vmax=0.05, aspect='auto')\n","    ax.set_xticks(range(nc)); ax.set_yticks(range(nr))\n","    ax.set_xticklabels([l[:14] for l in col_labs],\n","                       fontsize=9, rotation=20, ha='right')\n","    ax.set_yticklabels([l[:18] for l in row_labs], fontsize=9)\n","    ax.set_xlabel(f'Effect ({direction.split(\"→\")[1].strip()})', fontsize=9)\n","    ax.set_ylabel(f'Cause ({direction.split(\"→\")[0].strip()})', fontsize=9)\n","    ax.set_title(direction, fontsize=11, fontweight='bold',\n","                 color=title_color, pad=8)\n","\n","    for ri in range(nr):\n","        for ci in range(nc):\n","            v = matrix[ri, ci]\n","            if not np.isnan(v):\n","                txt = f'{v:.4f}\\n✔' if v < ALPHA_BONF else f'{v:.4f}'\n","                ax.text(ci, ri, txt, ha='center', va='center',\n","                        fontsize=8, fontweight='bold',\n","                        color='white' if v < ALPHA_BONF else '#333333')\n","\n","    plt.colorbar(im, ax=ax, fraction=0.04, pad=0.04,\n","                 label='p-value')\n","\n","plt.tight_layout()\n","path = os.path.join(OUTPUT_DIR, 'granger_intergroup_vecm_heatmap.png')\n","fig.savefig(path, dpi=150, bbox_inches='tight',\n","            facecolor=fig.get_facecolor())\n","plt.show()\n","\n","# ── Summary ───────────────────────────────────────────────────────────────────\n","print(f\"\\n{'='*70}\")\n","print(f\"INTER-GROUP SUMMARY  (α* = {ALPHA_BONF})\")\n","print(f\"{'='*70}\")\n","confirmed = df_ig[df_ig['Reject_H0'] == True]\n","if len(confirmed):\n","    for _, r in confirmed.iterrows():\n","        print(f\"  ✔ [{r['Direction']}]  \"\n","              f\"{r['Cause']:<22} → {r['Effect']:<22} \"\n","              f\"(F={r['F_stat']:.3f}, p={r['p_value']:.4f})\")\n","else:\n","    print(\"  No inter-group pairs confirmed at Bonferroni α* = 0.0021\")\n","    print(\"\\n  Exploratory (unadjusted α = 0.05):\")\n","    expl = df_ig[df_ig['p_value'] < 0.05]\n","    for _, r in expl.iterrows():\n","        print(f\"  ~  [{r['Direction']}]  \"\n","              f\"{r['Cause']:<22} → {r['Effect']:<22} \"\n","              f\"(p={r['p_value']:.4f})\")\n","\n","print(f\"\\nSaved → granger_intergroup_vecm.csv\")\n","print(f\"Saved → granger_intergroup_vecm_heatmap.png\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"-JvXJEWWTAkT","executionInfo":{"status":"ok","timestamp":1780621604000,"user_tz":-60,"elapsed":1143,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"687982ce-fcd4-418b-ee87-2c74fe2d7bf1"},"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":["Inter-group pairs: 24  |  Bonferroni α* = 0.05\n","\n","Cause                        Effect                         F-stat    p-value       α*  Result\n","──────────────────────────────────────────────────────────────────────────────────────\n","  CPI Inflation              Brent Crude Oil               0.177     0.9500   0.0500    n.s.\n","  CPI Inflation              Natural Gas (EU)              0.182     0.9477   0.0500    n.s.\n","  CPI Inflation              Diamond Index                 0.042     0.9966   0.0500    n.s.\n","  CPI Inflation              Gold PPI                      0.276     0.8935   0.0500    n.s.\n","  USD/AOA                    Brent Crude Oil               0.723     0.5769   0.0500    n.s.\n","  USD/AOA                    Natural Gas (EU)              3.331     0.0111   0.0500  ✔ REJECT H₀\n","  USD/AOA                    Diamond Index                 1.441     0.2209   0.0500    n.s.\n","  USD/AOA                    Gold PPI                      1.922     0.1071   0.0500    n.s.\n","  Real Interest Rate         Brent Crude Oil               1.424     0.2263   0.0500    n.s.\n","  Real Interest Rate         Natural Gas (EU)              1.462     0.2142   0.0500    n.s.\n","  Real Interest Rate         Diamond Index                 0.024     0.9989   0.0500    n.s.\n","  Real Interest Rate         Gold PPI                      0.469     0.7582   0.0500    n.s.\n"