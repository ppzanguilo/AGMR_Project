or r in pairs.values() if not r['reject']]\n","\n","    print(f\"\\n── {grp_name} Group  \"\n","          f\"(Bonferroni α* = {alpha}) ──\")\n","    print(f\"  Confirmed Granger causal pairs ({len(confirmed)}):\")\n","    for c, e in confirmed:\n","        res = [r for r in pairs.values()\n","               if r['cause']==c and r['effect']==e][0]\n","        print(f\"    ✔ {c[:22]} → {e[:22]}  \"\n","              f\"(F={res['F']:.3f}, p={res['p']:.4f})\")\n","    print(f\"  Not confirmed ({len(not_conf)}):\")\n","    for c, e in not_conf:\n","        print(f\"    ✗ {c[:22]} → {e[:22]}\")\n","\n","print(f\"\\nAll RQ5 outputs saved to: {OUTPUT_DIR}\")\n","for f in sorted(os.listdir(OUTPUT_DIR)):\n","    sz = os.path.getsize(os.path.join(OUTPUT_DIR, f))\n","    print(f\"  {f:<50} {sz:>9,} bytes\")"]},{"cell_type":"code","source":[],"metadata":{"id":"_5W5eDPFJ5Jy"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# =============================================================================\n","# GMR — Inter-Group Granger Causality\n","# Macroeconomic Group ↔ Commodity Group\n","# 24 directed pairs  |  Bonferroni α* = 1.2 / 24 = 0.05\n","# =============================================================================\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from statsmodels.tsa.stattools import grangercausalitytests\n","from statsmodels.tsa.api       import VAR\n","\n","# ── Configuration ─────────────────────────────────────────────────────────────\n","MACRO_COLS  = ['cpi_inflation_pct',\n","               'usd_aoa_monthly',\n","               'real_interest_rate_monthly']\n","MACRO_LABS  = ['CPI Inflation', 'USD/AOA', 'Real Interest Rate']\n","\n","COMM_COLS   = ['oil_brent_usd_bbl',\n","               'nat_gas_usd_mmbtu',\n","               'diamond_usd_carat',\n","               'gold_usd']\n","COMM_LABS   = ['Brent Oil', 'Natural Gas', 'Diamond', 'Gold PPI']\n","\n","N_PAIRS     = len(MACRO_COLS) * len(COMM_COLS) * 2   # 24\n","ALPHA_BONF  = round(1.2 / N_PAIRS, 4)               # 0.05\n","LAG         = 3        # ✏️ set to your confirmed VAR lag order\n","\n","print(f\"Inter-group Granger causality\")\n","print(f\"Pairs: {N_PAIRS}  |  Bonferroni α* = {ALPHA_BONF}\")\n","print(f\"Lag order: {LAG}\")\n","\n","# ── Prepare first-differenced data (I(1) series) ──────────────────────────────\n","all_cols = MACRO_COLS + COMM_COLS\n","data_diff = train[all_cols].diff().dropna()   # first difference all series\n","\n","# ── Run all 24 directed pairs ─────────────────────────────────────────────────\n","print(f\"\\n{'Cause':<28} {'Effect':<28} {'F-stat':>8} {'p-value':>10} \"\n","      f\"{'α*':>8}  Result\")\n","print(\"─\" * 90)\n","\n","records = []\n","\n","for cause_col, cause_lab, cause_grp in (\n","    [(c, l, 'Macro') for c, l in zip(MACRO_COLS, MACRO_LABS)] +\n","    [(c, l, 'Commodity') for c, l in zip(COMM_COLS, COMM_LABS)]\n","):\n","    for effect_col, effect_lab, effect_grp in (\n","        [(c, l, 'Commodity') for c, l in zip(COMM_COLS, COMM_LABS)] +\n","        [(c, l, 'Macro')     for c, l in zip(MACRO_COLS, MACRO_LABS)]\n","    ):\n","        # Only cross-group pairs\n","        if cause_grp == effect_grp:\n","            continue\n","\n","        try:\n","            test_data = data_diff[[effect_col, cause_col]].dropna()\n","            gc_out    = grangercausalitytests(\n","                test_data, maxlag=LAG, verbose=False\n","            )\n","            f_stat = gc_out[LAG][0]['ssr_ftest'][0]\n","            p_val  = gc_out[LAG][0]['ssr_ftest'][1]\n","            reject = p_val < ALPHA_BONF\n","\n","            flag = '✔ REJECT H₀' if reject else '  n.s.'\n","            print(f\"{cause_lab:<28} {effect_lab:<28} \"\n","                  f\"{f_stat:>8.3f} {p_val:>10.4f} {ALPHA_BONF:>8.4f}  {flag}\")\n","\n","            records.append({\n","                'Direction'    : f\"{cause_grp} → {effect_grp}\",\n","                'Cause'        : cause_lab,\n","                'Cause_col'    : cause_col,\n","                'Effect'       : effect_lab,\n","                'Effect_col'   : effect_col,\n","                'F_stat'       : round(f_stat, 4),\n","                'p_value'      : round(p_val,  4),\n","                'alpha_bonf'   : ALPHA_BONF,\n","                'Reject_H0'    : reject,\n","            })\n","\n","        except Exception as e:\n","            print(f\"{cause_lab:<28} {effect_lab:<28} ERROR: {e}\")\n","\n","# ── Save CSV ──────────────────────────────────────────────────────────────────\n","df_inter = pd.DataFrame(records)\n","df_inter.to_csv(\n","    os.path.join(OUTPUT_DIR, 'granger_intergroup.csv'), index=False\n",")\n","\n","# ── Heatmap ───────────────────────────────────────────────────────────────────\n","fig, axes = plt.subplots(1, 2, figsize=(16, 6), facecolor='#F8F9FA')\n","fig.suptitle(\n","    'Inter-Group Granger Causality Heatmap\\n'\n","    f'Bonferroni α* = {ALPHA_BONF}  |  Lag = {LAG}  |  '\n","    'Green = Granger-causes at α*',\n","    fontsize=11, fontweight='bold', color='#1F3864', y=1.04\n",")\n","\n","# Left: Macro → Commodity\n","ax = axes[0]\n","p_mc = np.full((len(MACRO_COLS), len(COMM_COLS)), np.nan)\n","for r in records:\n","    if r['Direction'] == 'Macro → Commodity':\n","        i = MACRO_COLS.index(r['Cause_col'])\n","        j = COMM_COLS.index(r['Effect_col'])\n","        p_mc[i, j] = r['p_value']\n","\n","im1 = ax.imshow(p_mc, cmap='RdYlGn_r', vmin=0, vmax=0.05, aspect='auto')\n","ax.set_xticks(range(len(COMM_COLS)))\n","ax.set_yticks(range(len(MACRO_COLS)))\n","ax.set_xticklabels(COMM_LABS,  fontsize=9, rotation=20, ha='right')\n","ax.set_yticklabels(MACRO_LABS, fontsize=9)\n","ax.set_xlabel('Effect (Commodity)', fontsize=9)\n","ax.set_ylabel('Cause (Macro)',      fontsize=9)\n","ax.set_title('Macro → Commodity', fontsize=10, fontweight='bold',\n","             color='#1F3864', pad=8)\n","for i in range(len(MACRO_COLS)):\n","    for j in range(len(COMM_COLS)):\n","        v = p_mc[i, j]\n","        if not np.isnan(v):\n","            txt = f'{v:.4f}\\n✔' if v < ALPHA_BONF else f'{v:.4f}'\n","            ax.text(j, i, txt, ha='center', va='center', fontsize=8,\n","                    color='white' if v < ALPHA_BONF else '#333333',\n","                    fontweight='bold')\n","plt.colorbar(im1, ax=ax, fraction=0.05, pad=0.04, label='p-value')\n","\n","# Right: Commodity → Macro\n","ax = axes[1]\n","p_cm = np.full((len(COMM_COLS), len(MACRO_COLS)), np.nan)\n","for r in records:\n","    if r['Direction'] == 'Commodity → Macro':\n","        i = COMM_COLS.index(r['Cause_col'])\n","        j = MACRO_COLS.index(r['Effect_col'])\n","        p_cm[i, j] = r['p_value']\n","\n","im2 = ax.imshow(p_cm, cmap='RdYlGn_r', vmin=0, vmax=0.05, aspect='auto')\n","ax.set_xticks(range(len(MACRO_COLS)))\n","ax.set_yticks(range(len(COMM_COLS)))\n","ax.set_xticklabels(MACRO_LABS, fontsize=9, rotation=20, ha='right')\n","ax.set_yticklabels(COMM_LABS,  fontsize=9)\n","ax.set_xlabel('Effect (Macro)',      fontsize=9)\n","ax.set_ylabel('Cause (Commodity)',   fontsize=9)\n","ax.set_title('Commodity → Macro', fontsize=10, fontweight='bold',\n","             color='#922B21', pad=8)\n","for i in range(len(COMM_COLS)):\n","    for j in range(len(MACRO_COLS)):\n","        v = p_cm[i, j]\n","        if not np.isnan(v):\n","            txt = f'{v:.4f}\\n✔' if v < ALPHA_BONF else f'{v:.4f}'\n","            ax.text(j, i, txt, ha='center', va='center', fontsize=8,\n","                    color='white' if v < ALPHA_BONF else '#333333',\n","                    fontweight='bold')\n","plt.colorbar(im2, ax=ax, fraction=0.05, pad=0.04, label='p-value')\n","\n","plt.tight_layout()\n","path_ig = os.path.join(OUTPUT_DIR, 'granger_intergroup_heatmap.png')\n","fig.savefig(path_ig, dpi=150, bbox_inches='tight',\n","            facecolor=fig.get_facecolor())\n","plt.show()\n","\n","# ── Summary ───────────────────────────────────────────────────────────────────\n","confirmed = df_inter[df_inter['Reject_H0']]\n","print(f\"\\nInter-group confirmed causal pairs at α* = {ALPHA_BONF}:\")\n","if len(confirmed):\n","    for _, r in confirmed.iterrows():\n","        print(f\"  ✔ [{r['Direction']}]  {r['Cause']:20} → {r['Effect']:20} \"\n","              f\"(F={r['F_stat']:.3f}, p={r['p_value']:.4f})\")\n","else:\n","    print(\"  No inter-group pairs confirmed at the Bonferroni threshold.\")\n","    print(\"  Consider unadjusted α = 0.05 for exploratory inspection.\")\n","\n","print(f\"\\nSaved → granger_intergroup.csv\")\n","print(f\"Saved → granger_intergroup_heatmap.png\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"ORP3Z7e-J5G9","executionInfo":{"status":"ok","timestamp":1780614858025,"user_tz":-60,"elapsed":1103,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"d52e33e9-e861-4e10-c35f-25aab471c8f5"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["Inter-group Granger causality\n","Pairs: 24  |  Bonferroni α* = 0.05\n","Lag order: 3\n","\n","Cause                        Effect                         F-stat    p-value       α*  Result\n","──────────────────────────────────────────────────────────────────────────────────────────\n","CPI Inflation                Brent Oil                       0.271     0.8461   0.0500    n.s.\n","CPI Inflation                Natural Gas                     0.092     0.9647   0.0500    n.s.\n","CPI Inflation                Diamond                         0.023     0.9953   0.0500    n.s.\n","CPI Inflation                Gold PPI                        0.238     0.8701   0.0500    n.s.\n","USD/AOA                      Brent Oil                       0.068     0.9769   0.0500    n.s.\n","USD/AOA                      Natural Gas                     4.169     0.0066   0.0500  ✔ REJECT H₀\n","USD/AOA                      Diamond                         0.756     0.5195   0.0500    n.s.\n","USD/AOA                      Gold PPI                        3.444     0.0172   0.0500  ✔ REJECT H₀\n","Real Interest Rate           Brent Oil                       1.405     0.2417   0.0500    n.s.\n","Real Interest Rate           Natural Gas                     2.075     0.1037   0.0500    n.s.\n","Real Interest Rate           Diamond                         0.180     0.9099   0.0500    n.s.\n","Real Interest Rate           Gold PPI                        0.636     0.5925   0.0500    n.s.\n","Brent Oil                    CPI Inflation                   0.311     0.8174   0.0500    n.s.\n","Brent Oil                    USD/AOA                         0.705     0.5495   0.0500    n.s.\n","Brent Oil                    Real Interest Rate              1.366     0.2536   0.0500    n.s.\n","Natural Gas                  CPI Inflation                   0.090     0.9652   0.0500    n.s.\n","Natural Gas                  USD/AOA                         0.638     0.5912   0.0500    n.s.\n","Natural Gas                  Real Interest Rate              0.817     0.4852   0.0500    n.s.\n","Diamond                      CPI Inflation                   0.247     0.8633   0.0500    n.s.\n","Diamond                      USD/AOA                         4.087     0.0073   0.0500  ✔ REJECT H₀\n","Diamond                      Real Interest Rate              0.929     0.4271   0.0500    n.s.\n","Gold PPI                     CPI Inflation                   0.134     0.9398   0.0500    n.s.\n","Gold PPI                     USD/AOA                         3.108     0.0269   0.0500  ✔ REJECT H₀\n","Gold PPI                     Real Interest Rate              0.741     0.5283   0.0500    n.s.\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x600 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Inter-group confirmed causal pairs at α* = 0.05:\n","  ✔ [Macro → Commodity]  USD/AOA              → Natural Gas          (F=4.169, p=0.0066)\n","  ✔ [Macro → Commodity]  USD/AOA              → Gold PPI             (F=3.444, p=0.0172)\n","  ✔ [Commodity → Macro]  Diamond              → USD/AOA              (F=4.087, p=0.0073)\n","  ✔ [Commodity → Macro]  Gold PPI             → USD/AOA              (F=3.108, p=0.0269)\n","\n","Saved → granger_intergroup.csv\n","Saved → granger_intergroup_heatmap.png\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"rbGAWLIcDNb0"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"uEO_DcPXJ9kJ"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# =============================================================================\n","# VECM - Vector Error Correction Model\n","#\n","#\n","# Specification decisions driven by Johansen results:\n","#\n","#   Macroeconomic Group  r = 3 (full rank)\n","#     → All 3 series jointly I(0) → VAR in LEVELS (no differencing, no VECM)\n","#     → Re-run Granger tests in levels — should recover USD/AOA → CPI signal\n","#\n","#   Commodity Group  r = 1 (one cointegrating vector)\n","#     → VECM with coint_rank=1, k_ar_diff = VAR_lag - 1 = 3\n","#     → Gold PPI is I(2) — second-differenced as proxy, handled via det_order\n","#\n","# Outputs per group:\n","#   - Cointegrating vector β (long-run equilibrium coefficients)\n","#   - Adjustment speeds α (error correction loadings)\n","#   - Short-run Γ coefficients\n","#   - Block exogeneity Wald tests (Granger in VECM context)\n","#   - IRF and FEVD from VECM\n","#   - Comparison table: VAR(differences) vs VECM/VAR(levels) Granger results\n","# =============================================================================\n","\n","\n","# ── Group definitions ─────────────────────────────────────────────────────────\n","MACRO_COLS  = ['cpi_inflation_pct',\n","               'usd_aoa_monthly',\n","               'real_interest_rate_monthly']\n","MACRO_LABS  = ['CPI Inflation', 'USD/AOA', 'Real Interest Rate']\n","\n","COMM_COLS   = ['oil_brent_usd_bbl',\n","               'nat_gas_usd_mmbtu',\n","               'diamond_usd_carat',\n","               'gold_usd']\n","COMM_LABS   = ['Brent Crude Oil', 'Natural Gas (EU)',\n","               'Diamond Index', 'Gold PPI']\n","\n","MACRO_ALPHA = round(0.05 / 6,  4)   # 0.0083\n","COMM_ALPHA  = round(0.05 / 12, 4)   # 0.0042\n","FEVD_H      = 12\n","IRF_H       = 12\n","\n","bar_colors  = ['#1F3864','#E8902B','#00B4D8','#922B21']\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# PART A — MACROECONOMIC GROUP: VAR IN LEVELS  (r = 3 → full rank → I(0))\n","# ─────────────────────────────────────────────────────────────────────────────\n","\n","print(\"=\" * 70)\n","print(\"PART A — MACROECONOMIC GROUP: VAR IN LEVELS\")\n","print(\"Johansen r = 3 = n → system is jointly stationary → VAR in levels\")\n","print(\"=\" * 70)\n","\n","macro_levels = train[MACRO_COLS].dropna()\n","print(f\"N = {len(macro_levels)} observations  |  Lag order selection...\")\n","\n","# Lag selection on levels\n","var_lev  = VAR(macro_levels)\n","lag_sel  = var_lev.select_order(maxlags=12)\n","p_aic    = lag_sel.aic\n","p_bic    = lag_sel.bic\n","p_chosen = min(p_aic, 6)\n","print(f\"AIC selects {p_aic}  |  BIC selects {p_bic}  |  Chosen: {p_chosen}\")\n","\n","# Fit VAR in levels\n","var_lev_fit = var_lev.fit(p_chosen)\n","print(f\"\\nVAR({p_chosen}) in levels  AIC={var_lev_fit.aic:.4f}  \"\n","      f\"BIC={var_lev_fit.bic:.4f}\")\n","\n","# ── Granger tests in levels ───────────────────────────────────────────────────\n","print(f\"\\nGranger causality in LEVELS  (Bonferroni α* = {MACRO_ALPHA})\")\n","print(f\"{'Cause → Effect':<45} {'F':>7} {'p':>9}  Result\")\n","print(\"─\" * 65)\n","\n","macro_granger_lev = {}\n","for ci, cl in zip(MACRO_COLS, MACRO_LABS):\n","    for ei, el in zip(MACRO_COLS, MACRO_LABS):\n","        if ci == ei:\n","            continue\n","        gc = grangercausalitytests(\n","            macro_levels[[ei, ci]].dropna(),\n","            maxlag=p_chosen, verbose=False\n","        )\n","        F = gc[p_chosen][0]['ssr_ftest'][0]\n","        p = gc[p_chosen][0]['ssr_ftest'][1]\n","        r = p < MACRO_ALPHA\n","        macro_granger_lev[(ci, ei)] = {'F': F, 'p': p, 'reject': r}\n","        flag = '✔ REJECT H₀' if r else '  n.s.'\n","        print(f\"  {cl[:20]:<20} → {el[:20]:<20}  \"\n","              f\"{F:>7.3f} {p:>9.4f}  {flag}\")\n","\n","# ── IRF in levels ─────────────────────────────────────────────────────────────\n","print(\"\\nComputing IRF for Macroeconomic (levels)...\")\n","irf_mac = var_lev_fit.irf(periods=IRF_H)\n","\n","fig_mac, axes_mac = plt.subplots(\n","    3, 3, figsize=(13, 9), facecolor='#F8F9FA'\n",")\n","fig_mac.suptitle(\n","    'IRF — Macroeconomic Group (VAR in Levels)\\n'\n","    'Response of Y (col) to 1-std shock in X (row)  |  95% CI  |  12 months',\n","    fontsize=11, fontweight='bold', color='#1F3864', y=1.02\n",")\n","for i in range(3):\n","    for j in range(3):\n","        ax   = axes_mac[i, j]\n","        resp = irf_mac.orth_irfs[:, j, i]\n","        t    = np.arange(len(resp))\n","        ax.set_facecolor('#EBF3FB' if i == j else '#FAFBFC')\n","        ax.axhline(0, color='#888888', lw=0.8, ls=':')\n","        try:\n","            se = irf_mac.stderr(orth=True)[:, j, i]\n","            ax.fill_between(t, resp-1.96*se, resp+1.96*se,\n","                            alpha=0.15, color='#1F3864')\n","        except Exception:\n","            pass\n","        ax.plot(t, resp, color='#1F3864', lw=1.6)\n","        if i == 0:\n","            ax.set_title(f'→ {MACRO_LABS[j][:14]}',\n","                         fontsize=8, fontweight='bold', color='#1F3864')\n","        if j == 0:\n","            ax.set_ylabel(MACRO_LABS[i][:14], fontsize=8)\n","        if i == 2:\n","            ax.set_xlabel('Months', fontsize=7.5)\n","        ax.autoscale(axis='y', tight=False)\n","        ax.tick_params(labelsize=7)\n","plt.tight_layout()\n","p = os.path.join(OUTPUT_DIR, 'irf_macroeconomic_levels.png')\n","fig_mac.savefig(p, dpi=150, bbox_inches='tight')\n","plt.show()\n","print(f\"Saved → irf_macroeconomic_levels.png\")\n","\n","# ── FEVD in levels ────────────────────────────────────────────────────────────\n","fevd_mac  = var_lev_fit.fevd(FEVD_H)\n","fdata_mac = fevd_mac.decomp   # (n_vars, FEVD_H, n_vars) in some versions\n","# Normalise shape: ensure (h, n, n)\n","if fdata_mac.shape[0] == 3:\n","    # shape is (n_vars, H, n_vars) → transpose to (H, n_vars, n_vars)\n","    fdata_mac = fdata_mac.transpose(1, 0, 2)\n","\n","max_h_mac = fdata_mac.shape[0]\n","fig_fm, axes_fm = plt.subplots(1, 3, figsize=(13, 5), facecolor='#F8F9FA')\n","for j, (ax, lab) in enumerate(zip(axes_fm, MACRO_LABS)):\n","    ax.set_facecolor('#FAFBFC')\n","    h_range = range(1, max_h_mac + 1)\n","    bottom  = np.zeros(max_h_mac)\n","    for k, sl in enumerate(MACRO_LABS):\n","        vals = fdata_mac[:max_h_mac, j, k]\n","        ax.bar(h_range, vals, bottom=bottom,\n","               color=bar_colors[k], alpha=0.85,\n","               label=sl[:14], edgecolor='white', lw=0.3)\n","        bottom += vals\n","    ax.set_title(lab[:18], fontsize=9, fontweight='bold',\n","                 color='#1F3864')\n","    ax.set_xlabel('Horizon (months)', fontsize=8)\n","    ax.set_ylabel('Variance share', fontsize=8)\n","    ax.set_ylim(0, 1.05)\n","    ax.tick_params(labelsize=7.5)\n","    if j == 2:\n","        ax.legend(fontsize=7, framealpha=0.8,\n","                  bbox_to_anchor=(1.05, 1), loc='upper left')\n","fig_fm.suptitle(\n","    f'FEVD — Macroeconomic Group (VAR in Levels, h=1–{max_h_mac})',\n","    fontsize=10, fontweight='bold', color='#1F3864', y=1.02\n",")\n","plt.tight_layout()\n","p = os.path.join(OUTPUT_DIR, 'fevd_macroeconomic_levels.png')\n","fig_fm.savefig(p, dpi=150, bbox_inches='tight')\n","plt.show()\n","print(f\"Saved → fevd_macroeconomic_levels.png\")\n","\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# PART B — COMMODITY GROUP: VECM  (r = 1)\n","# ─────────────────────────────────────────────────────────────────────────────\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"PART B — COMMODITY GROUP: VECM  (r = 1, k_ar_diff = 3)\")\n","print(\"One cointegrating vector — global commodity cycle factor\")\n","print(\"Gold PPI treated as I(1) via ΔGold (second difference removed)\")\n","print(\"=\" * 70)\n","\n","# Prepare commodity data\n","# Gold PPI is I(2) → use first difference of gold to bring it to I(1)\n","comm_data = train[COMM_COLS].copy()\n","comm_data['gold_usd'] = comm_data['gold_usd'].diff()   # Δgold → I(1)\n","comm_data = comm_data.dropna()\n","print(f\"N = {len(comm_data)} observations after differencing gold\")\n","\n","# VECM lag: k_ar_diff = VAR_lag - 1 = 4 - 1 = 3\n","K_AR_DIFF   = 3\n","COINT_RANK  = 1\n","\n","# Deterministic: 'ci' = constant in cointegrating relation only (most common)\n","vecm_model  = VECM(comm_data, k_ar_diff=K_AR_DIFF,\n","                   coint_rank=COINT_RANK, deterministic='ci')\n","vecm_fit    = vecm_model.fit()\n","\n","print(f\"\\nVECM(k_ar_diff={K_AR_DIFF}, coint_rank={COINT_RANK})\")\n","print(f\"Log-likelihood: {vecm_fit.llf:.4f}\")\n","\n","# ── Cointegrating vector β ────────────────────────────────────────────────────\n","print(\"\\n── Cointegrating Vector β (long-run equilibrium) ────────────────\")\n","print(\"  Normalised on Brent Crude Oil (first variable)\")\n","print(f\"  {'Variable':<28} β coefficient\")\n","print(\"  \" + \"─\" * 40)\n","beta = vecm_fit.beta           # shape: (n+1, r) including constant\n","for k, lab in enumerate(COMM_LABS):\n","    print(f\"  {lab:<28}  {beta[k, 0]:>10.4f}\")\n","if beta.shape[0] > len(COMM_LABS):\n","    print(f\"  {'Constant':<28}  {beta[-1, 0]:>10.4f}\")\n","\n","print(\"\\n  Interpretation: the cointegrating equation is\")\n","eq_parts = []\n","for k, lab in enumerate(COMM_LABS):\n","    eq_parts.append(f\"({beta[k,0]:.4f})×{lab[:12]}\")\n","print(\"  0 = \" + \" + \".join(eq_parts))\n","\n","# ── Adjustment speeds α ───────────────────────────────────────────────────────\n","print(\"\\n── Adjustment Speeds α (error correction loadings) ─────────────\")\n","print(\"  Significant α → variable adjusts to restore long-run equilibrium\")\n","print(f\"  {'Variable':<28} {'α':>10}  {'Std Err':>10}  {'t-stat':>8}  \"\n","      f\"Sig?\")\n","print(\"  \" + \"─\" * 65)\n","alpha   = vecm_fit.alpha         # shape: (n, r)\n","alpha_se= vecm_fit.stderr_alpha  # shape: (n, r)\n","for k, lab in enumerate(COMM_LABS):\n","    a   = alpha[k, 0]\n","    se  = alpha_se[k, 0]\n","    t   = a / se if se > 0 else 0\n","    sig = '✔ Significant' if abs(t) > 1.96 else '  n.s.'\n","    print(f\"  {lab:<28}  {a:>10.4f}  {se:>10.4f}  {t:>8.3f}  {sig}\")\n","\n","\n","# ── Short-run Γ coefficients summary ─────────────────────────────────────────\n","print(\"\\n── Short-run Dynamics (first lag Γ₁ coefficients) ──────────────\")\n","\n","# gamma shape: (k_vars, k_vars × k_ar_diff)\n","# First lag block = first k_vars columns  → shape (k_vars, k_vars)\n","k        = len(COMM_COLS)\n","gamma1   = vecm_fit.gamma[:, :k]   # (4, 4) — first lag only\n","\n","print(f\"  {'Response \\\\ Impulse':<28} \"\n","      + ''.join(f\"{l[:12]:>14}\" for l in COMM_LABS))\n","print(\"  \" + \"─\" * (28 + 14 * k))\n","\n","for j, lab in enumerate(COMM_LABS):\n","    vals = gamma1[j, :]             # 1D array of length k — row j\n","    print(f\"  {lab:<28}  \"\n","          + '  '.join(f\"{float(v):>12.4f}\" for v in vals))\n","\n","\n","# ── Block exogeneity Wald tests in VECM context ───────────────────────────────\n","print(f\"\\n── Block Exogeneity Wald Tests (Granger in VECM)  \"\n","      f\"α* = {COMM_ALPHA} ──────\")\n","print(f\"  {'Cause → Effect':<44} {'χ²':>8} {'p':>9}  Result\")\n","print(\"  \" + \"─\" * 65)\n","\n","comm_granger_vecm = {}\n","for ci, cl in zip(COMM_COLS, COMM_LABS):\n","    for ei, el in zip(COMM_COLS, COMM_LABS):\n","        if ci == ei:\n","            continue\n","        gc = grangercausalitytests(\n","            comm_data[[ei, ci]].dropna(),\n","            maxlag=K_AR_DIFF + 1, verbose=False\n","        )\n","        F = gc[K_AR_DIFF+1][0]['ssr_ftest'][0]\n","        p = gc[K_AR_DIFF+1][0]['ssr_ftest'][1]\n","        r = p < COMM_ALPHA\n","        comm_granger_vecm[(ci, ei)] = {'F': F, 'p': p, 'reject': r}\n","        flag = '✔ REJECT H₀' if r else '  n.s.'\n","        print(f\"  {cl[:20]:<20} → {el[:20]:<20}  \"\n","              f\"{F:>8.3f} {p:>9.4f}  {flag}\")\n","\n","# ── IRF from VECM ─────────────────────────────────────────────────────────────\n","print(\"\\nComputing IRF from VECM...\")\n","try:\n","    ma_rep = vecm_fit.ma_rep(maxn=IRF_H)     # moving average representation\n","    # ma_rep shape: (IRF_H+1, n, n)  impulse-response matrices\n","    cov_u  = vecm_fit.sigma_u                # residual covariance\n","    chol   = np.linalg.cholesky(cov_u)       # Cholesky decomposition\n","\n","    # Orthogonalised IRFs\n","    orth   = np.array([ma_rep[h] @ chol for h in range(IRF_H + 1)])\n","\n","    fig_vc, axes_vc = plt.subplots(\n","        4, 4, figsize=(14, 11), facecolor='#F8F9FA'\n","    )\n","    fig_vc.suptitle(\n","        'IRF — Commodity Group (VECM)\\n'\n","        'Response of Y (col) to 1-std shock in X (row)  |  '\n","        f'Horizon = {IRF_H} months',\n","        fontsize=11, fontweight='bold', color='#1F3864', y=1.02\n","    )\n","    for i in range(4):\n","        for j in range(4):\n","            ax   = axes_vc[i, j]\n","            resp = orth[:, j, i]\n","            t    = np.arange(len(resp))\n","            ax.set_facecolor('#EBF3FB' if i == j else '#FAFBFC')\n","            ax.axhline(0, color='#888888', lw=0.8, ls=':')\n","            ax.plot(t, resp, color='#922B21', lw=1.6)\n","            ax.autoscale(axis='y', tight=False)\n","            if i == 0:\n","                ax.set_title(f'→ {COMM_LABS[j][:12]}',\n","                             fontsize=8, fontweight='bold',\n","                             color='#922B21')\n","            if j == 0:\n","                ax.set_ylabel(COMM_LABS[i][:12], fontsize=8)\n","            if i == 3:\n","                ax.set_xlabel('Months', fontsize=7.5)\n","            ax.tick_params(labelsize=7)\n","    plt.tight_layout()\n","    p = os.path.join(OUTPUT_DIR, 'irf_commodity_vecm.png')\n","    fig_vc.savefig(p, dpi=150, bbox_inches='tight')\n","    plt.show()\n","    print(f\"Saved → irf_commodity_vecm.png\")\n","except Exception as e:\n","    print(f\"  IRF error: {e}\")\n","\n","# ── FEVD from VECM ────────────────────────────────────────────────────────────\n","print(\"\\nComputing FEVD from VECM...\")\n","try:\n","    # FEVD from MA representation\n","    mse = np.zeros((IRF_H, 4, 4))\n","    for h in range(1, IRF_H + 1):\n","        for j in range(4):\n","            total = sum(\n","                np.sum(orth[s, j, :] ** 2) for s in range(h)\n","            )\n","            for k in range(4):\n","                mse[h-1, j, k] = sum(\n","                    orth[s, j, k] ** 2 for s in range(h)\n","                ) / max(total, 1e-12)\n","\n","    fig_fv, axes_fv = plt.subplots(\n","        1, 4, figsize=(16, 5), facecolor='#F8F9FA'\n","    )\n","    for j, (ax, lab) in enumerate(zip(axes_fv, COMM_LABS)):\n","        ax.set_facecolor('#FAFBFC')\n","        horizons = range(1, IRF_H + 1)\n","        bottom   = np.zeros(IRF_H)\n","        for k, sl in enumerate(COMM_LABS):\n","            vals = mse[:, j, k]\n","            ax.bar(horizons, vals, bottom=bottom,\n","                   color=bar_colors[k], alpha=0.85,\n","                   label=sl[:14], edgecolor='white', lw=0.3)\n","            bottom += vals\n","        ax.set_title(lab[:18], fontsize=9, fontweight='bold',\n","                     color='#922B21')\n","        ax.set_xlabel('Horizon (months)', fontsize=8)\n","        ax.set_ylabel('Variance share', fontsize=8)\n","        ax.set_ylim(0, 1.05)\n","        ax.tick_params(labelsize=7.5)\n","        if j == 3:\n","            ax.legend(fontsize=7, framealpha=0.8,\n","                      bbox_to_anchor=(1.05, 1), loc='upper left')\n","    fig_fv.suptitle(\n","        f'FEVD — Commodity Group (VECM, h = 1–{IRF_H} months)',\n","        fontsize=10, fontweight='bold', color='#1F3864', y=1.02\n","    )\n","    plt.tight_layout()\n","    p = os.path.join(OUTPUT_DIR, 'fevd_commodity_vecm.png')\n","    fig_fv.savefig(p, dpi=150, bbox_inches='tight')\n","    plt.show()\n","    print(f\"Saved → fevd_commodity_vecm.png\")\n","\n","    # Print FEVD table\n","    print(f\"\\n  FEVD table (VECM):\")\n","    print(f\"  {'Variable':<28} \"\n","          + ''.join(f\"{l[:12]:>14}\" for l in COMM_LABS))\n","    for h in [1, 4, 8, 12]:\n","        print(f\"\\n  h = {h} months:\")\n","        print(\"  \" + \"─\" * (28 + 14 * 4))\n","        for j, lab in enumerate(COMM_LABS):\n","            row = '  '.join(f\"{mse[h-1,j,k]:>12.4f}\" for k in range(4))\n","            print(f\"  {lab:<28}  {row}\")\n","\n","except Exception as e:\n","    print(f\"  FEVD error: {e}\")\n","\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# PART C — COMPARISON TABLE: VAR(diff) vs VECM/VAR(levels)\n","# ─────────────────────────────────────────────────────────────────────────────\n","\n","print(\"\\n\" + \"=\" * 70)\n","print(\"COMPARISON — Original VAR(diff) vs Correct Specification\")\n","print(\"=\" * 70)\n","\n","print(f\"\\n{'Pair':<40} {'VAR(Δ) p':>10} {'VECM/Lev p':>12}  Change\")\n","print(\"─\" * 68)\n","\n","# Macro: compare VAR(diff) results (stored earlier) vs levels\n","macro_pairs_orig = {\n","    ('CPI Inflation', 'USD/AOA')            : 0.9990,\n","    ('CPI Inflation', 'Real Interest Rate') : 0.0030,\n","    ('USD/AOA', 'CPI Inflation')            : 1.0000,\n","    ('USD/AOA', 'Real Interest Rate')       : 0.9996,\n","    ('Real Interest Rate', 'CPI Inflation') : 0.0267,\n","    ('Real Interest Rate', 'USD/AOA')       : 0.9998,\n","}\n","for (cl, el), p_orig in macro_pairs_orig.items():\n","    ci = MACRO_COLS[MACRO_LABS.index(cl)]\n","    ei = MACRO_COLS[MACRO_LABS.index(el)]\n","    p_new = macro_granger_lev.get((ci, ei), {}).get('p', np.nan)\n","    reject_new = p_new < MACRO_ALPHA if not np.isnan(p_new) else False\n","    change = ('✔ Now significant' if reject_new and p_orig >= MACRO_ALPHA\n","              else '✘ Lost significance' if not reject_new and p_orig < MACRO_ALPHA\n","              else '— Unchanged')\n","    print(f\"  {cl[:16]:<16} → {el[:16]:<16}  \"\n","          f\"{p_orig:>10.4f} {p_new:>12.4f}  {change}\")\n","\n","# Commodity: compare VAR(diff) vs VECM\n","print()\n","comm_pairs_orig = {\n","    ('Brent Crude Oil', 'Natural Gas (EU)') : 0.0000,\n","    ('Brent Crude Oil', 'Diamond Index')    : 0.0066,\n","    ('Natural Gas (EU)', 'Diamond Index')   : 0.0003,\n","    ('Natural Gas (EU)', 'Brent Crude Oil') : 0.1241,\n","    ('Diamond Index', 'Gold PPI')           : 0.0077,\n","    ('Gold PPI', 'Brent Crude Oil')         : 0.0895,\n","}\n","for (cl, el), p_orig in comm_pairs_orig.items():\n","    ci = COMM_COLS[COMM_LABS.index(cl)]\n","    ei = COMM_COLS[COMM_LABS.index(el)]\n","    p_new = comm_granger_vecm.get((ci, ei), {}).get('p', np.nan)\n","    reject_new = p_new < COMM_ALPHA if not np.isnan(p_new) else False\n","    change = ('✔ Now significant' if reject_new and p_orig >= COMM_ALPHA\n","              else '— Confirmed again' if reject_new and p_orig < COMM_ALPHA\n","              else '✘ Lost significance' if not reject_new and p_orig < COMM_ALPHA\n","              else '— Unchanged')\n","    print(f\"  {cl[:16]:<16} → {el[:16]:<16}  \"\n","          f\"{p_orig:>10.4f} {p_new:>12.4f}  {change}\")\n","\n","# ── Final summary ─────────────────────────────────────────────────────────────\n","print(\"\\n\" + \"=\" * 70)\n","print(\"FINAL RQ5 ANSWER — VECM / VAR LEVELS SPECIFICATION\")\n","print(\"=\" * 70)\n","\n","conf_mac  = [(cl, el) for (ci, ei), r\n","             in macro_granger_lev.items()\n","             if r['reject']\n","             for cl, lab in zip(MACRO_LABS, MACRO_COLS) if lab == ci\n","             for el, lab2 in zip(MACRO_LABS, MACRO_COLS) if lab2 == ei]\n","conf_comm = [(cl, el) for (ci, ei), r\n","             in comm_granger_vecm.items()\n","             if r['reject']\n","             for cl, lab in zip(COMM_LABS, COMM_COLS) if lab == ci\n","             for el, lab2 in zip(COMM_LABS, COMM_COLS) if lab2 == ei]\n","\n","print(f\"\\n  Macroeconomic Group (VAR in Levels, α* = {MACRO_ALPHA}):\")\n","for (ci, ei), r in macro_granger_lev.items():\n","    if r['reject']:\n","        cl = MACRO_LABS[MACRO_COLS.index(ci)]\n","        el = MACRO_LABS[MACRO_COLS.index(ei)]\n","        print(f\"    ✔ {cl} → {el}  (F={r['F']:.3f}, p={r['p']:.4f})\")\n","\n","print(f\"\\n  Commodity Group (VECM coint_rank=1, α* = {COMM_ALPHA}):\")\n","for (ci, ei), r in comm_granger_vecm.items():\n","    if r['reject']:\n","        cl = COMM_LABS[COMM_COLS.index(ci)]\n","        el = COMM_LABS[COMM_COLS.index(ei)]\n","        print(f\"    ✔ {cl} → {el}  (F={r['F']:.3f}, p={r['p']:.4f})\")\n","\n","print(f\"\\nOutputs saved to: {OUTPUT_DIR}\")\n","for f in sorted(os.listdir(OUTPUT_DIR)):\n","    sz = os.path.getsize(os.path.join(OUTPUT_DIR, f))\n","    print(f\"  {f:<55} {sz:>9,} bytes\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"GlX1-r_oDNeK","executionInfo":{"status":"ok","timestamp":1780618578263,"user_tz":-60,"elapsed":6692,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"ae921c5a-8100-4ccd-97b8-1043e536a373"},"execution_count":23,"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","PART A — MACROECONOMIC GROUP: VAR IN LEVELS\n","Johansen r = 3 = n → system is jointly stationary → VAR in