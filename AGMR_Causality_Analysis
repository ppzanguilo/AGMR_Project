f]])\n","        elif n > 1:\n","            axes_irf = np.array(axes_irf).reshape(n, n)\n","\n","        fig_irf.suptitle(\n","            f'Impulse Response Functions — {grp_name} Group\\n'\n","            f'Response of Y (column) to 1-std shock in X (row)  |  '\n","            f'Shaded = 95% CI  |  Horizon = {FEVD_STEPS} months',\n","            fontsize=11, fontweight='bold', color='#1F3864', y=1.02\n","        )\n","\n","        for i in range(n):      # impulse (row)\n","            for j in range(n):  # response (column)\n","                ax   = axes_irf[i, j]\n","                resp = orth_irfs[:, j, i]\n","                t    = np.arange(len(resp))\n","\n","                ax.set_facecolor('#FAFBFC')\n","                ax.axhline(0, color='#888888', linewidth=0.8,\n","                           linestyle=':', zorder=1)\n","\n","                # 95% CI band\n","                if has_se:\n","                    se = orth_se[:, j, i]\n","                    ax.fill_between(t,\n","                                    resp - 1.96 * se,\n","                                    resp + 1.96 * se,\n","                                    alpha=0.15, color=color, zorder=2)\n","\n","                ax.plot(t, resp, color=color, linewidth=1.6, zorder=3)\n","\n","                # Auto-scale each subplot independently\n","                ax.autoscale(axis='y', tight=False)\n","                margin = max(abs(resp).max() * 0.15, 1e-6)\n","                ax.set_ylim(resp.min() - margin, resp.max() + margin)\n","\n","                # Labels — top row = effect labels, left col = impulse labels\n","                if i == 0:\n","                    ax.set_title(f'→ {labels[j][:14]}',\n","                                 fontsize=8, fontweight='bold',\n","                                 color=color, pad=4)\n","                if j == 0:\n","                    ax.set_ylabel(labels[i][:14], fontsize=8)\n","\n","                if i == n - 1:\n","                    ax.