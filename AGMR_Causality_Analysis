======================================================\n","# ── CELL 09: Granger Causality Tests ─────────────────────────────────────────\n","# =============================================================================\n","\n","print(\"\\n\" + \"=\"*70)\n","print(\"GRANGER CAUSALITY F-TESTS\")\n","print(\"H₀: X does NOT Granger-cause Y\")\n","print(\"Reject H₀ → X Granger-causes Y\")\n","print(\"=\"*70)\n","\n","granger_results = {}   # { grp: { (cause, effect): {F, p, reject} } }\n","\n","for grp_name, grp in GROUPS.items():\n","    cols        = grp['cols']\n","    labels      = grp['labels']\n","    alpha_bonf  = grp['alpha_bonf']\n","    p           = lag_orders[grp_name]\n","    fitted      = var_results[grp_name]\n","    data        = var_data[grp_name]\n","\n","    print(f\"\\n{'═'*65}\")\n","    print(f\"GROUP: {grp_name}  |  VAR({p})\")\n","    print(f\"Bonferroni α* = {alpha_bonf}  \"\n","          f\"(0.05 / {grp['n_pairs']} pairs)\")\n","    print(f\"{'═'*65}\")\n","    print(f\"\\n  {'Cause → Effect':<45} {'F-stat':>8} {'p-value':>10} \"\n","          f\"{'Bonf α*':>10}  Result\")\n","    print(\"  \" + \"─\" * 75)\n","\n","    granger_results[grp_name] = {}\n","\n","    # All directed pairs (cause → effect)\n","    for i, (cause_col, cause_lab) in enumerate(zip(cols, labels)):\n","        for j, (effect_col, effect_lab) in enumerate(zip(cols, labels)):\n","            if cause_col == effect_col:\n","                continue\n","\n","            pair_label = f\"{cause_lab[:18]} → {effect_lab[:18]}\"\n","\n","            try:\n","                # statsmodels grangercausalitytests: tests whether\n","                # cause_col Granger-causes effect_col\n","                test_data = data[[effect_col, cause_col]].dropna()\n","                gc_out    = grangercausalitytests(\n","                    test_data, maxlag=p, verbose=False\n","                )\n","                # Use F-test at the selected lag order\n","                f_stat = gc_out[p