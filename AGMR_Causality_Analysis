ors = ['#1F3864', '#E8902B', '#00B4D8', '#27AE60',\n","                      '#922B21', '#8E44AD', '#16A085']\n","\n","        fig_fevd, axes_fevd = plt.subplots(\n","            1, n, figsize=(4.5 * n, 5), facecolor='#F8F9FA'\n","        )\n","        if n == 1:\n","            axes_fevd = [axes_fevd]\n","\n","        for j, (ax, lab) in enumerate(zip(axes_fevd, labels)):\n","            ax.set_facecolor('#FAFBFC')\n","            horizons = range(1, plot_h + 1)\n","            bottom   = np.zeros(plot_h)\n","\n","            for k, src_lab in enumerate(labels):\n","                vals = fevd_data[:plot_h, j, k]\n","                ax.bar(horizons, vals, bottom=bottom,\n","                       color=bar_colors[k % len(bar_colors)],\n","                       label=src_lab[:14], alpha=0.85,\n","                       edgecolor='white', linewidth=0.3)\n","                bottom += vals\n","\n","            ax.set_title(lab[:18], fontsize=9, fontweight='bold',\n","                         color=color, loc='center')\n","            ax.set_xlabel('Horizon (months)', fontsize=8)\n","            ax.set_ylabel('Variance share',   fontsize=8)\n","            ax.set_ylim(0, 1.05)\n","            ax.tick_params(labelsize=7.5)\n","            if j == n - 1:\n","                ax.legend(fontsize=7, framealpha=0.8,\n","                          bbox_to_anchor=(1.05, 1), loc='upper left')\n","\n","        fig_fevd.suptitle(\n","            f'FEVD — {grp_name} Group  (h = 1–{plot_h} months)\\n'\n","            'Proportion of forecast error variance explained by each series',\n","            fontsize=10, fontweight='bold', color='#1F3864', y=1.02\n","        )\n","        plt.tight_layout()\n","        path_fevd = os.path.join(OUTPUT_DIR, f'fevd_{grp_name.lower()}.png')\n","        fig_fevd.savefig(path_fevd, dpi=150, bbox_inches='tight',\n","                         facecolor=fig_fevd.get_facecolor())\n","        plt.show()\n","        print(f\"Saved → fevd_{grp_name.lower()}.png\")\n","\n","    except Exception as e:\n","        print(f\"  FEVD error: {e}\")\n","        import traceback\n","        traceback.print_exc()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"cy382Cj_DNY-","executionInfo":{"status":"ok","timestamp":1780614531913,"user_tz":-60,"elapsed":2248,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"3ca40826-8c7c-4507-f493-5592257ef9fd"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","======================================================================\n","FORECAST ERROR VARIANCE DECOMPOSITION  (h = 12 months)\n","======================================================================\n","\n","── Macroeconomic Group ──\n","  FEVD shape: (3, 12, 3)  (horizons=3, vars=3)\n","\n","  h = 1 months:\n","  Variable                       CPI Inflatio  USD/AOA Exch  Real Interes\n","  ──────────────────────────────────────────────────────────────────────\n","  CPI Inflation                       1.0000        0.0000        0.0000\n","  USD/AOA Exchange Rate               0.9777        0.0000        0.0223\n","  Real Interest Rate                  0.9618        0.0000        0.0382\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1350x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved → fevd_macroeconomic.png\n","\n","── Commodity Group ──\n","  FEVD shape: (4, 12, 4)  (horizons=4, vars=4)\n","\n","  h = 1 months:\n","  Variable                       Brent Crude   Natural Gas   Diamond Inde      Gold PPI\n","  ────────────────────────────────────────────────────────────────────────────────────\n","  Brent Crude Oil                     1.0000        0.0000        0.0000        0.0000\n","  Natural Gas (EU)                    0.9907        0.0074        0.0006        0.0013\n","  Diamond Index                       0.9891        0.0078        0.0014