\n","from matplotlib.lines import Line2D\n","import os\n","import warnings\n","warnings.filterwarnings('ignore')\n","import matplotlib.gridspec as gridspec\n","from matplotlib.patches import Patch\n","import scipy.stats as stats\n","from statsmodels.graphics.tsaplots import plot_acf, plot_pacf\n","from statsmodels.tsa.stattools import adfuller, kpss\n","\n","pd.set_option('display.float_format', '{:.4f}'.format)\n","pd.set_option('display.max_columns', 20)\n","pd.set_option('display.width', 130)\n","\n","\n","\n","FONT = 'DejaVu Sans'\n","plt.rcParams.update({\n","    'font.family'       : FONT,\n","    'axes.spines.top'   : False,\n","    'axes.spines.right' : False,\n","    'axes.grid'         : True,\n","    'grid.linestyle'    : ':',\n","    'grid.alpha'        : 0.35,\n","})\n","\n","\n","print(\"Libraries loaded ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"d7TX10tF6jwT","executionInfo":{"status":"ok","timestamp":1778260271388,"user_tz":-60,"elapsed":24,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"31b0971e-2665-4bd2-9480-db11d38c2e88"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Libraries loaded ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"S1mFe6LE6CeV"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","DATA_DIR = '/content/drive/MyDrive/AGMR/timeseries/raw'\n","\n","OUTPUT_DIR = '/content/drive/MyDrive/AGMR/outputs/stationarity'\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","\n","\n","PANEL_FILE = os.path.join(DATA_DIR, 'agmr_panel_7series_monthly.csv')\n","SUBSET_START = '1995-01-01'\n","SUBSET_END   = '2025-12-01'"],"metadata":{"id":"b8kSRDjjc-_Y"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"BfeFribfc_E2"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["panel = pd.read_csv(PANEL_FILE, parse_dates=['date'])\n","panel = panel.sort_values('date').reset_index(drop=True)\n","\n","panel_subset = panel[\n","    (panel['date'] >= SUBSET_START) &\n","    (panel['date'] <= SUBSET_END)\n","].copy().reset_index(drop=True)\n","\n","print(f\"panel_subset: {panel_subset.shape[0]} rows  |  \"\n","      f\"{panel_subset['date'].min().strftime('%Y-%m')} → \"\n","      f\"{panel_subset['date'].max().strftime('%Y-%m')}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"fzxI8FUbkaoG","executionInfo":{"status":"ok","timestamp":1778260287853,"user_tz":-60,"elapsed":967,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"d7f9b8d3-31f1-4a6f-a06c-2cc796552140"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["panel_subset: 372 rows  |  1995-01 → 2025-12\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"uTEilf81kalO"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"G00JJREzkaqS"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"TTlCnhJYkatL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n"],"metadata":{"id":"kJplC-Fm6jy1"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Series metadata\n","\n","SERIES = [\n","    ('cpi_inflation_pct',          'CPI Inflation',          '% monthly',     '#1F3864'),\n","    ('usd_aoa_monthly',            'USD/AOA Exchange Rate',  'Kz per USD',    '#1F3864'),\n","    ('real_interest_rate_monthly', 'Real Interest Rate',     '% monthly',      '#1F3864'),\n","    ('oil_brent_usd_bbl',          'Brent Crude Oil',        'USD/bbl',       '#922B21'),\n","    ('nat_gas_usd_mmbtu',          'Natural Gas (EU)',        'USD/mmbtu',     '#922B21'),\n","    ('diamond_usd_carat',          'Diamond Index',          'Index 2000=100','#922B21'),\n","    ('gold_usd',                   'Gold PPI',               'USD/oz',        '#922B21'),\n","]\n","COLS   = [s[0] for s in SERIES]\n","LABELS = {s[0]: s[1] for s in SERIES}\n","\n","# Subsamples for robustness checks\n","SUBSAMPLES = {\n","    'cpi_inflation_pct'          : [('Full sample',    SUBSET_START, SUBSET_END),\n","                                    ('Post-2002',       '2003-01-01', SUBSET_END),\n","                                    ('Post-2014',       '2014-01-01', SUBSET_END)],\n","    'usd_aoa_monthly'            : [('Full sample',    SUBSET_START, SUBSET_END),\n","                                    ('Post-2014',       '2014-01-01', SUBSET_END)],\n","    'real_interest_rate_monthly' : [('Full sample',    SUBSET_START, SUBSET_END),\n","                                    ('Post-2014',       '2014-01-01', SUBSET_END)],\n","    'oil_brent_usd_bbl'          : [('Full sample',    SUBSET_START, SUBSET_END),\n","                                    ('Post-2014',       '2014-01-01', SUBSET_END)],\n","    'nat_gas_usd_mmbtu'          : [('Full sample',    SUBSET_START, SUBSET_END),\n","                                    ('Post-2014',       '2014-01-01', SUBSET_END)],\n","    'diamond_usd_carat'          : [('Full sample',    SUBSET_START, SUBSET_END),\n","                                    ('Post-2014',       '2014-01-01', SUBSET_END)],\n","    'gold_usd'                   : [('Full sample',    SUBSET_START, SUBSET_END),\n","                                    ('Post-2014',       '2014-01-01', SUBSET_END)],\n","}\n","\n","print(\"Series metadata configured ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"BcC-rjoRgEV8","executionInfo":{"status":"ok","timestamp":1778260297560,"user_tz":-60,"elapsed":23,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"72b74ec2-2e52-4992-fd0f-ec46d3c7245f"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Series metadata configured ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"5pMCKQY4gEYu"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# ADF and KPSS test functions\n","\n","def run_adf(series, maxlag=12):\n","    \"\"\"\n","    ADF test.\n","    H0: series has a unit root (non-stationary).\n","    Reject H0 if p-value < 0.05 → series is stationary I(0).\n","    \"\"\"\n","    s = series.dropna()\n","    r = adfuller(s, maxlag=maxlag, autolag='AIC')\n","    return {\n","        'stat'    : round(r[0], 4),\n","        'p'       : round(r[1], 4),\n","        'lags'    : r[2],\n","        'n'       : r[3],\n","        'crit_1'  : round(r[4]['1%'],  4),\n","        'crit_5'  : round(r[4]['5%'],  4),\n","        'crit_10' : round(r[4]['10%'], 4),\n","        'reject'  : r[1] < 0.05,     # True → stationary at 5%\n","    }\n","\n","def run_kpss(series, regression='c'):\n","    \"\"\"\n","    KPSS test.\n","    H0: series is stationary (trend-stationary around a constant).\n","    Reject H0 if stat > critical value → series is non-stationary.\n","    \"\"\"\n","    s = series.dropna()\n","    r = kpss(s, regression=regression, nlags='auto')\n","    return {\n","        'stat'    : round(r[0], 4),\n","        'p'       : round(r[1], 4),\n","        'crit_5'  : round(r[3]['5%'],  4),\n","        'reject'  : r[0] > r[3]['5%'],  # True → non-stationary\n","    }\n","\n","def integration_order(adf_level, adf_diff):\n","    \"\"\"\n","    Determine integration order from ADF results.\n","    I(0): stationary at levels.\n","    I(1): non-stationary at levels, stationary at first difference.\n","    I(2): non-stationary at both levels and first difference.\n","    \"\"\"\n","    if adf_level['reject']:\n","        return 'I(0)'\n","    elif adf_diff['reject']:\n","        return 'I(1)'\n","    else:\n","        return 'I(2)+'\n","\n","print(\"Test functions defined ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"71lrAv9cgEbS","executionInfo":{"status":"ok","timestamp":1778260299485,"user_tz":-60,"elapsed":22,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"1242c032-e528-4fbb-b484-bff097b5fd1a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Test functions defined ✓\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"hIMAQ7WrgEdX"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# Full stationarity analysis\n","\n","\n","results = []\n","\n","for col, label, unit, color in SERIES:\n","    subsamples = SUBSAMPLES.get(col, [('Full sample', SUBSET_START, SUBSET_END)])\n","\n","    for ss_label, ss_start, ss_end in subsamples:\n","\n","        s = panel_subset[\n","            (panel_subset['date'] >= ss_start) &\n","            (panel_subset['date'] <= ss_end)\n","        ][col].dropna()\n","\n","        if len(s) < 20:\n","            continue\n","\n","        # ── ADF at levels ─────────────────────────────────────────────────────\n","        adf_l = run_adf(s)\n","\n","        # ── ADF at first differences ──────────────────────────────────────────\n","        adf_d = run_adf(s.diff().dropna())\n","\n","        # ── KPSS at levels ────────────────────────────────────────────────────\n","        kpss_l = run_kpss(s)\n","\n","        # ── KPSS at first differences ─────────────────────────────────────────\n","        kpss_d = run_kpss(s.diff().dropna())\n","\n","        # ── Integration order ─────────────────────────────────────────────────\n","        i_d = integration_order(adf_l, adf_d)\n","\n","        # For conclusion we combine ADF and KPSS results\n","        # Stationary if: ADF rejects H0 (p<0.05) AND KPSS does NOT reject H0\n","        # Non-stationary if: ADF does NOT reject AND KPSS rejects\n","        # Inconclusive if: both or neither reject\n","        adf_stat  = 'Stationary'    if adf_l['reject']  else 'Non-stationary'\n","        kpss_stat = 'Stationary'    if not kpss_l['reject'] else 'Non-stationary'\n","        if adf_stat == kpss_stat:\n","            conclusion = adf_stat\n","        else:\n","            conclusion = 'Inconclusive — check first differences'\n","\n","        results.append({\n","            'Series'           : label,\n","            'Subsample'        : ss_label,\n","            'N'                : len(s),\n","            # ADF levels\n","            'ADF stat (level)' : adf_l['stat'],\n","            'ADF p (level)'    : adf_l['p'],\n","            'ADF lags'         : adf_l['lags'],\n","            'ADF crit 5%'      : adf_l['crit_5'],\n","            'ADF decision'     : 'Reject H\\u2080' if adf_l['reject'] else 'Fail to reject H\\u2080',\n","            # ADF first diff\n","            'ADF stat (\\u0394)'  : adf_d['stat'],\n","            'ADF p (\\u0394)'     : adf_d['p'],\n","            # KPSS levels\n","            'KPSS stat (level)': kpss_l['stat'],\n","            'KPSS p (level)'   : kpss_l['p'],\n","            'KPSS crit 5%'     : kpss_l['crit_5'],\n","            'KPSS decision'    : 'Reject H\\u2080' if kpss_l['reject'] else 'Fail to reject H\\u2080',\n","            # Integration order\n","            'I(d)'             : i_d,\n","            'Conclusion'       : conclusion,\n","        })\n","\n","df_results = pd.DataFrame(results)\n","\n","print(\"=\" * 100)\n","print(\"STATIONARITY RESULTS — ADF + KPSS\")\n","print(\"ADF  H\\u2080: unit root (non-stationary). Reject H\\u2080 \\u2192 series is I(0).\")\n","print(\"KPSS H\\u2080: series is stationary.        Reject H\\u2080 \\u2192 series is non-stationary.\")\n","print(\"=\" * 100)\n","print(df_results.to_string(index=False))\n","\n","# Save\n","path_csv = os.path.join(OUTPUT_DIR, 'stationarity_summary.csv')\n","df_results.to_csv(path_csv, index=False)\n","print(f\"\\nSaved → {path_csv}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"h2ttP3sb6j2B","executionInfo":{"status":"ok","timestamp":1778260301514,"user_tz":-60,"elapsed":286,"user":{"displayName":"Príncipe Zanguilo","userId":"07987990092382516207"}},"outputId":"8c41e7a8-0f9e-475d-caf2-91f70b74ab09"},"execution_count":null,"outputs":[{"output_ty